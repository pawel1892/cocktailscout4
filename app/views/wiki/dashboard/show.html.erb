<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
  <div>
    <h1 class="font-display font-semibold text-[38px] leading-tight tracking-tight text-cs-red-900">Wiki</h1>
    <div class="w-10 h-0.5 bg-cs-gold-400 mt-3 mb-2.5"></div>
  </div>
  <div class="flex items-center gap-3">
    <%= link_to wiki_articles_path, class: "btn btn-outline btn-sm" do %>
      <i class="fas fa-list mr-1"></i> Alle Artikel
    <% end %>
    <% if Current.user&.can_edit_wiki? %>
      <%= link_to drafts_wiki_articles_path, class: "btn btn-outline btn-sm" do %>
        <i class="fas fa-file-alt mr-1"></i> Entwürfe
      <% end %>
      <%= link_to new_wiki_article_path, class: "btn btn-primary btn-sm" do %>
        <i class="fas fa-plus mr-1"></i> Neuer Artikel
      <% end %>
    <% end %>
  </div>
</div>

<div class="mb-8">
  <%= form_tag search_wiki_articles_path, method: :get do %>
    <div class="relative">
      <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-cs-ink-400 text-lg pointer-events-none"></i>
      <%= text_field_tag :q, nil,
            placeholder: "Wiki durchsuchen… Gin, Shaker, Vermouth",
            class: "input-field py-4 text-lg w-full",
            style: "padding-left: 3rem; padding-right: 8rem;" %>
      <button type="submit" class="btn btn-primary absolute right-2 top-1/2 -translate-y-1/2">
        Suchen
      </button>
    </div>
  <% end %>
</div>

<% if @featured_articles.empty? %>
  <div class="card card-ghost p-12 text-center">
    <i class="fas fa-book-open text-5xl mb-4 block text-cs-ink-300"></i>
    <p class="text-cs-ink-500">Noch keine hervorgehobenen Artikel vorhanden.</p>
    <% if Current.user&.admin? || Current.user&.super_moderator? %>
      <p class="text-sm text-cs-ink-400 mt-2">Artikel bearbeiten und <strong>Featured</strong> aktivieren, um sie hier anzuzeigen.</p>
    <% end %>
  </div>
<% else %>
  <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
    <% @featured_articles.each do |article| %>
      <div class="card overflow-hidden hover:shadow-md transition-shadow">
        <% if article.cover_image.attached? %>
          <%= link_to wiki_article_path(article) do %>
            <div class="h-44 overflow-hidden bg-cs-ink-100">
              <%= image_tag article.cover_image.variant(:hero),
                  class: "w-full h-full object-cover",
                  alt: "" %>
            </div>
          <% end %>
        <% else %>
          <%= link_to wiki_article_path(article) do %>
            <div class="h-44 bg-gradient-to-br from-cs-ink-100 to-cs-ink-200 flex items-center justify-center">
              <i class="fas fa-book-open text-4xl text-cs-ink-300"></i>
            </div>
          <% end %>
        <% end %>
        <div class="card-body p-4">
          <h2 class="font-display font-semibold text-[20px] leading-tight text-cs-red-900 mb-2">
            <%= link_to article.title, wiki_article_path(article), class: "hover:text-cs-red-700 transition-colors" %>
          </h2>
          <% if article.ingredients.any? %>
            <div class="mb-2 flex flex-wrap gap-1">
              <% article.ingredients.each do |ingredient| %>
                <span class="tag tag-neutral"><i class="fas fa-flask mr-1"></i><%= ingredient.name %></span>
              <% end %>
            </div>
          <% end %>
          <p class="text-sm text-cs-ink-500 line-clamp-3">
            <%= article.body.gsub(/[#*_\[\]`>]/, '').strip.truncate(250) %>
          </p>
          <div class="mt-3">
            <%= link_to "Weiterlesen →", wiki_article_path(article), class: "link link-arrow text-sm" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% end %>
