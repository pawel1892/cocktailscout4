<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
  <div class="lg:col-span-2">
    <script>window.activityStream = <%= raw @activity_stream.to_json %>;</script>
    <div class="card">
      <div class="card-header">Aktivitäten</div>
      <div class="card-body">
        <activity-stream></activity-stream>
      </div>
    </div>
  </div>

  <%# Sidebar %>
  <div class="lg:col-span-1 space-y-8">
     <div class="card">
        <div class="card-header">
          Gerade aktive User
        </div>
        <img src="/images/active_users_small.jpg" alt="Aktive Benutzer" class="w-full h-48 object-cover">
        <div class="card-body">
          <online-users :initial-users='<%= @online_users.map { |u| { id: u.id, username: u.username, rank: u.rank, avatar_url_small: u.avatar_path(:small) } }.to_json %>'></online-users>
        </div>
     </div>

     <div class="card">
       <div class="card-body text-center">
         <h3 class="font-bold text-cs-dark-red font-serif text-lg mb-2">Cocktail Forum</h3>
         <p class="text-sm text-cs-ink-600 mb-4">Diskutiere Rezepte, teile Tipps und tausche dich mit anderen Cocktail-Fans aus.</p>
         <%= link_to "Zum Forum", forum_topics_path, class: "btn btn-primary w-full" %>
       </div>
     </div>
  </div>
</div>
