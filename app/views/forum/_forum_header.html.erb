<% active = local_assigns[:active] %>
<% forum_topic = local_assigns[:forum_topic] %>
<% forum_thread = local_assigns[:forum_thread] %>

<% if forum_topic %>
  <nav class="flex items-center gap-1.5 text-sm mb-6">
    <%= link_to "Cocktailforum", forum_topics_path, class: "link" %>
    <% if forum_thread %>
      <i class="fas fa-chevron-right text-[9px] text-cs-ink-300"></i>
      <%= link_to forum_topic.name, forum_topic_path(forum_topic.slug), class: "link" %>
      <i class="fas fa-chevron-right text-[9px] text-cs-ink-300"></i>
      <span class="text-cs-ink-700 truncate max-w-[240px]"><%= forum_thread.title %></span>
    <% else %>
      <i class="fas fa-chevron-right text-[9px] text-cs-ink-300"></i>
      <span class="text-cs-ink-700"><%= forum_topic.name %></span>
    <% end %>
  </nav>
<% end %>
