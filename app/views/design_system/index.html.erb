<% content_for :full_bleed_page, true %>

<%
  scales = {
    red: {
      label: "Red",
      hexes: { 50 => "#FEF9F8", 100 => "#F4EFEE", 200 => "#E9DAD8", 300 => "#D0C0BE", 400 => "#BC8F8A", 500 => "#A16F6A", 600 => "#82534E", 700 => "#5D3A37", 800 => "#47211F", 900 => "#330A0A", 950 => "#0F0202" }
    },
    gold: {
      label: "Gold",
      hexes: { 50 => "#FDFBEE", 100 => "#F4F1E1", 200 => "#EBDFA6", 300 => "#D3C581", 400 => "#B6A555", 500 => "#938016", 600 => "#706000", 700 => "#524500", 800 => "#382D00", 900 => "#221A00", 950 => "#080600" }
    },
    ink: {
      label: "Ink",
      hexes: { 50 => "#FCF9F9", 100 => "#F2EFEF", 200 => "#E4DCDB", 300 => "#CBC2C0", 400 => "#ACA2A0", 500 => "#887D7C", 600 => "#675E5C", 700 => "#4B4342", 800 => "#322C2B", 900 => "#1E1919", 950 => "#070505" }
    },
    blue: {
      label: "Blue",
      hexes: { 50 => "#F5F8FA", 100 => "#EBF0F5", 200 => "#D7E1EB", 300 => "#B3C6D6", 400 => "#8EAAC1", 500 => "#6A8EAC", 600 => "#4D708E", 700 => "#1F486C", 800 => "#183854", 900 => "#10283C", 950 => "#08141E" }
    }
  }

  semantic = {
    success: { label: "Success", hexes: { 50 => "#E8F6EC", 400 => "#46B26E", 500 => "#16A34A", 700 => "#0D7A35" } },
    warning: { label: "Warning", hexes: { 50 => "#FDF6DF", 400 => "#E6AC0E", 500 => "#CA8A04", 700 => "#8D6002" } },
    error:   { label: "Error",   hexes: { 50 => "#FCECEC", 400 => "#E14A4A", 500 => "#DC2626", 700 => "#A01818" } }
  }
%>

<div class="bg-cs-ink-50 text-cs-ink-900 min-h-screen font-sans antialiased text-inherit">

  <!-- SIDEBAR BACKDROP -->
  <div id="ds-backdrop" class="ds-backdrop" onclick="dsCloseSidebar()"></div>

  <!-- SIDEBAR PANEL -->
  <div id="ds-sidebar" class="ds-sidebar">
    <div class="flex items-center justify-between px-5 py-4 border-b border-cs-ink-200 flex-shrink-0">
      <span class="font-mono text-cs-ink-500 text-[10px] uppercase tracking-widest font-bold">Navigation</span>
      <button onclick="dsCloseSidebar()" class="p-1.5 rounded-md text-cs-ink-500 hover:bg-cs-ink-100 hover:text-cs-ink-900 transition-all" aria-label="Close">
        <i class="fa-solid fa-xmark text-base leading-none"></i>
      </button>
    </div>
    <nav class="flex flex-col gap-0.5 p-3 overflow-y-auto">
      <% ["Colors", "Type", "Links", "Buttons", "Cards", "Tags", "Callouts", "Forms", "Tables", "Composite"].each_with_index do |nav, i| %>
        <a href="#<%= nav.downcase %>" onclick="dsCloseSidebar()" class="flex items-center gap-2.5 px-3 py-2.5 rounded-md text-[13px] font-medium text-cs-ink-700 hover:bg-cs-ink-100 hover:text-cs-red-900 no-underline transition-all">
          <span class="font-mono text-cs-ink-400 text-[10px] w-5 flex-shrink-0">0<%= i+1 %></span>
          <%= nav %>
        </a>
      <% end %>
    </nav>
  </div>

  <!-- TOPBAR -->
  <header class="flex items-center justify-between sticky top-0 z-50 bg-cs-ink-50/80 backdrop-blur-md border-b border-cs-ink-200 px-4 sm:px-8 py-3">
    <a href="#" class="flex-shrink-0">
      <img src="/logo_red.svg" class="h-9 w-auto" alt="CocktailScout">
    </a>

    <!-- Desktop nav (lg+) -->
    <nav class="hidden xl:flex flex-wrap gap-1 bg-cs-ink-100 border border-cs-ink-200 p-1.5 rounded-xl">
      <% ["Colors", "Type", "Links", "Buttons", "Cards", "Tags", "Callouts", "Forms", "Tables", "Composite"].each_with_index do |nav, i| %>
        <a href="#<%= nav.downcase %>" class="px-3 py-1.5 rounded-md text-[12px] font-medium text-cs-ink-700 hover:bg-cs-ink-50 hover:text-cs-red-900 no-underline transition-all">
          0<%= i+1 %> · <%= nav %>
        </a>
      <% end %>
    </nav>

    <!-- Burger (hidden on lg+) -->
    <button onclick="dsOpenSidebar()" class="xl:hidden p-2 rounded-md text-cs-ink-600 hover:bg-cs-ink-100 hover:text-cs-ink-900 transition-all" aria-label="Open navigation">
      <i class="fa-solid fa-bars text-lg leading-none"></i>
    </button>
  </header>

  <div class="max-w-[1180px] mx-auto px-4 sm:px-6 md:px-8 py-12 pb-24">

    <h1 class="font-display font-semibold text-[42px] leading-tight tracking-tight text-cs-red-900 mb-4">CocktailScout Design System <span class="text-cs-gold-600 font-medium text-2xl align-baseline">v2</span></h1>

    <p class="text-cs-ink-600 text-sm max-w-[720px] mb-10 leading-relaxed">
      A fuller tonal system for CocktailScout — brand oxblood and brass each expanded into an 11-step scale,
      a warm neutral to replace flat gray, and semantic colors with light/base/dark triads.
      Components below are re-composed on top of these tokens so buttons, cards, tags, callouts and forms
      have real hover / pressed / muted states instead of relying on <code>opacity-80</code>.
    </p>

    <!-- ================= 01 COLORS ================= -->
    <section id="colors" class="mb-20 scroll-mt-24">
      <div class="flex items-baseline justify-between gap-4 border-b border-cs-ink-200 pb-3 mb-6">
        <h2 class="m-0 font-display font-semibold text-4xl text-cs-red-900 tracking-tight">Color</h2>
        <span class="font-mono text-cs-ink-500 text-xs uppercase tracking-widest">01</span>
      </div>
      <p class="text-cs-ink-600 text-sm max-w-[720px] mb-8">
        Three tonal scales anchor everything. Brand anchors stay put: <code>red-900 = #330A0A</code>, <code>gold-400 = #B6A555</code>.
        The neutral is <em>warm</em> (slight red/amber undertone) so it reads as paper-and-ink under gold light.
      </p>

      <% scales.each do |key, data| %>
        <div class="text-cs-ink-500 font-bold text-[11px] uppercase tracking-widest mb-3.5 mt-8"><%= data[:label] %> — <%= key == :red ? "OXBLOOD (DARK RED)" : (key == :gold ? "BRASS (GOLD)" : (key == :ink ? "WARM NEUTRAL" : "BLUE (INFO & LINKS)")) %></div>
        <div class="scale-label"><%= data[:label] %><small>cs-<%= key %></small></div>
        <div class="scale-row">
          <% data[:hexes].each do |step, hex| %>
            <div class="swatch bg-cs-<%= key %>-<%= step %> <%= step >= 400 ? 'text-white' : 'text-cs-ink-900' %>">
              <span class="step"><%= step %></span>
              <span class="hex"><%= hex %></span>
            </div>
          <% end %>
        </div>
      <% end %>

      <div class="text-cs-ink-500 font-bold text-[11px] uppercase tracking-widest mb-3.5 mt-10">SEMANTIC — SUCCESS · WARNING · ERROR</div>
      <div class="flex flex-col gap-3">
        <% semantic.each do |key, data| %>
          <div>
            <div class="scale-label"><%= data[:label] %><small>cs-<%= key %></small></div>
            <div class="scale-row-4">
              <% data[:hexes].each do |step, hex| %>
                <div class="swatch bg-cs-<%= key %>-<%= step %> <%= step >= 400 ? 'text-white' : 'text-cs-ink-900' %>">
                  <span class="step"><%= step %></span>
                  <span class="hex"><%= hex %></span>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    </section>

    <!-- ================= 02 TYPE ================= -->
    <section id="type" class="mb-20 scroll-mt-24">
      <div class="flex items-baseline justify-between gap-4 border-b border-cs-ink-200 pb-3 mb-6">
        <h2 class="m-0 font-display font-semibold text-4xl text-cs-red-900 tracking-tight">Typography</h2>
        <span class="font-mono text-cs-ink-500 text-xs uppercase tracking-widest">02</span>
      </div>
      <p class="text-cs-ink-600 text-sm max-w-[720px] mb-8">
        <strong>Cormorant Garamond</strong> (display serif) for headings — evokes classic bar menus. 
        <strong>Inter</strong> for UI, body copy and numeric ratings. 
        <strong>JetBrains Mono</strong> for token values, stats and counts.
      </p>
      <div class="divide-y divide-cs-ink-200">
        <div class="grid grid-cols-[80px_1fr] md:grid-cols-[120px_1fr_auto] gap-4 py-5 items-baseline">
          <span class="font-mono text-cs-ink-500 uppercase text-[10px] font-bold tracking-widest">Display</span>
          <span class="text-cs-red-900 font-display font-semibold text-[54px] leading-none tracking-tight">Cocktail Rezepte</span>
          <span class="hidden md:block font-mono text-cs-ink-500 text-right text-[11px]">Serif 600 · 54/54</span>
        </div>
        <div class="grid grid-cols-[80px_1fr] md:grid-cols-[120px_1fr_auto] gap-4 py-5 items-baseline">
          <span class="font-mono text-cs-ink-500 uppercase text-[10px] font-bold tracking-widest">H1 / Hero</span>
          <span class="text-cs-red-900 font-display font-semibold text-[38px] leading-tight tracking-tight">Cocktail Rezepte & deine persönliche Bar</span>
          <span class="hidden md:block font-mono text-cs-ink-500 text-right text-[11px]">Serif 600 · 38/44</span>
        </div>
        <div class="grid grid-cols-[80px_1fr] md:grid-cols-[120px_1fr_auto] gap-4 py-5 items-baseline">
          <span class="font-mono text-cs-ink-500 uppercase text-[10px] font-bold tracking-widest">H2</span>
          <span class="text-cs-red-900 font-display font-semibold text-[28px] leading-tight">Heute frisch gemixt</span>
          <span class="hidden md:block font-mono text-cs-ink-500 text-right text-[11px]">Serif 600 · 28/32</span>
        </div>
        <div class="grid grid-cols-[80px_1fr] md:grid-cols-[120px_1fr_auto] gap-4 py-5 items-baseline">
          <span class="font-mono text-cs-ink-500 uppercase text-[10px] font-bold tracking-widest">H3 / Card</span>
          <span class="text-cs-ink-900 font-sans font-bold text-[18px]">Long Island Iced Tea</span>
          <span class="hidden md:block font-mono text-cs-ink-500 text-right text-[11px]">Inter 700 · 18/24</span>
        </div>
        <div class="grid grid-cols-[80px_1fr] md:grid-cols-[120px_1fr_auto] gap-4 py-5 items-baseline">
          <span class="font-mono text-cs-ink-500 uppercase text-[10px] font-bold tracking-widest">Body</span>
          <span class="text-cs-ink-800 font-sans font-normal text-[15px] leading-relaxed">1.500+ Cocktail Rezepte — und mit Meine Bar siehst du sofort, was du mixen kannst.</span>
          <span class="hidden md:block font-mono text-cs-ink-500 text-right text-[11px]">Inter 400 · 15/24</span>
        </div>
        <div class="grid grid-cols-[80px_1fr] md:grid-cols-[120px_1fr_auto] gap-4 py-5 items-baseline">
          <span class="font-mono text-cs-ink-500 uppercase text-[10px] font-bold tracking-widest">Small</span>
          <span class="text-cs-ink-600 font-sans font-normal text-[13px]">vor 19 Minuten · von Ripuli</span>
          <span class="hidden md:block font-mono text-cs-ink-500 text-right text-[11px]">Inter 400 · 13/18</span>
        </div>
        <div class="grid grid-cols-[80px_1fr] md:grid-cols-[120px_1fr_auto] gap-4 py-5 items-baseline">
          <span class="font-mono text-cs-ink-500 uppercase text-[10px] font-bold tracking-widest">Mono / Stat</span>
          <span class="text-cs-ink-700 font-mono font-medium text-[13px]">1.124.100 views · 14.3% ABV</span>
          <span class="hidden md:block font-mono text-cs-ink-500 text-right text-[11px]">JBMono 500 · 13/18</span>
        </div>
        <div class="grid grid-cols-[80px_1fr] md:grid-cols-[120px_1fr_auto] gap-4 py-5 items-baseline">
          <span class="font-mono text-cs-ink-500 uppercase text-[10px] font-bold tracking-widest">Eyebrow</span>
          <span class="text-cs-ink-500 font-sans font-bold uppercase text-[11px] tracking-widest">KATEGORIE · KLASSIKER</span>
          <span class="hidden md:block font-mono text-cs-ink-500 text-right text-[11px]">Inter 700 · 11/14</span>
        </div>
      </div>
    </section>

    <!-- ================= 03 LINKS ================= -->
    <section id="links" class="mb-20 scroll-mt-24">
      <div class="flex items-baseline justify-between gap-4 border-b border-cs-ink-200 pb-3 mb-6">
        <h2 class="m-0 font-display font-semibold text-4xl text-cs-red-900 tracking-tight">Links</h2>
        <span class="font-mono text-cs-ink-500 text-xs uppercase tracking-widest">03</span>
      </div>
      <p class="text-cs-ink-600 text-sm max-w-[720px] mb-8">
        Dedicated blue scale (<code>cs-blue</code>). Underlines appear on hover via <code>border-bottom</code> for sharpness.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-8 p-6 bg-white border border-cs-ink-200 rounded-xl shadow-sm text-inherit">
        <div>
          <div class="text-cs-ink-500 uppercase tracking-widest mb-2.5 font-bold text-[10px]">Default — <code class="bg-cs-ink-50 px-1 rounded">.link</code></div>
          <p class="text-[15px] leading-relaxed">Unser <a href="#" class="link">Mojito-Rezept</a> ist heute dreimal so beliebt wie gestern. Alle Klassiker findest du <a href="#" class="link">in der Rezeptübersicht</a>.</p>
        </div>
        <div>
          <div class="text-cs-ink-500 uppercase tracking-widest mb-2.5 font-bold text-[10px]">Underline — <code class="bg-cs-ink-50 px-1 rounded">.link-underline</code></div>
          <p class="text-[15px] leading-relaxed">Teil unserer <a href="#" class="link link-underline">Allgemeinen Geschäftsbedingungen</a> und <a href="#" class="link link-underline">Datenschutzerklärung</a>.</p>
        </div>
        <div>
          <div class="text-cs-ink-500 uppercase tracking-widest mb-2.5 font-bold text-[10px]">Muted — <code class="bg-cs-ink-50 px-1 rounded">.link-muted</code></div>
          <p class="text-[15px] leading-relaxed">Breadcrumbs & Footer: <a href="#" class="link link-muted">Startseite</a> › <a href="#" class="link link-muted">Rezepte</a> › <strong>Long Island</strong>.</p>
        </div>
        <div>
          <div class="text-cs-ink-500 uppercase tracking-widest mb-2.5 font-bold text-[10px]">Arrow — <code class="bg-cs-ink-50 px-1 rounded">.link-arrow</code></div>
          <p class="text-[15px] leading-relaxed"><a href="#" class="link-arrow text-sm">Alle Rezepte ansehen <span class="arr">→</span></a><br/><a href="#" class="link-arrow text-sm">Zur Community <span class="arr">→</span></a></p>
        </div>
        <div>
          <div class="text-cs-ink-500 uppercase tracking-widest mb-2.5 font-bold text-[10px]">Danger — <code class="bg-cs-ink-50 px-1 rounded">.link-danger</code></div>
          <p class="text-[15px] leading-relaxed">Achtung: <a href="#" class="link link-danger">Konto löschen</a> oder <a href="#" class="link link-danger">Beitrag melden</a>.</p>
        </div>
        <div class="bg-cs-red-900 p-6 rounded-lg -m-1">
          <div class="text-cs-gold-400 uppercase tracking-widest mb-2 font-bold text-[10px]">On Dark — <code class="bg-cs-red-950 px-1 rounded">.link-on-dark</code></div>
          <p class="text-cs-gold-100 text-[15px] leading-relaxed"><a href="#" class="link link-on-dark italic">Impressum</a>, <a href="#" class="link link-on-dark italic">Datenschutz</a>, <a href="#" class="link link-on-dark italic">Kontakt</a>.</p>
        </div>
      </div>

      <div class="text-cs-ink-500 font-bold text-[11px] uppercase tracking-widest mb-3.5 mt-8">BUTTON-SHAPED LINK — <code class="normal-case">.btn.btn-link</code></div>
      <div class="flex gap-3">
        <button class="btn btn-primary">Speichern</button>
        <button class="btn btn-outline">Vorschau</button>
        <button class="btn btn-link">Abbrechen</button>
      </div>
    </section>

    <!-- ================= 04 BUTTONS ================= -->
    <section id="buttons" class="mb-20 scroll-mt-24">
      <div class="flex items-baseline justify-between gap-4 border-b border-cs-ink-200 pb-3 mb-6">
        <h2 class="m-0 font-display font-semibold text-4xl text-cs-red-900 tracking-tight">Buttons</h2>
        <span class="font-mono text-cs-ink-500 text-xs uppercase tracking-widest">04</span>
      </div>
      <div class="flex flex-wrap gap-3 items-center mb-10">
        <button class="btn btn-primary">Rezept speichern</button>
        <button class="btn btn-gold">Rezepte entdecken</button>
        <button class="btn btn-outline">Meine Bar</button>
        <button class="btn btn-soft">Favoritenliste</button>
        <button class="btn btn-ghost">Abbrechen</button>
        <button class="btn btn-danger"><i class="fa-solid fa-trash mr-1"></i> Löschen</button>
        <button class="btn btn-link">Mehr erfahren</button>
        <button class="btn btn-primary" disabled>Disabled State</button>
      </div>

      <div class="text-cs-ink-500 font-bold text-[11px] uppercase tracking-widest mb-3.5">SIZES</div>
      <div class="flex flex-wrap gap-3 items-center mb-10">
        <button class="btn btn-primary btn-sm">Small Button</button>
        <button class="btn btn-primary">Default Size</button>
        <button class="btn btn-primary btn-lg">Large Action</button>
      </div>

      <div class="text-cs-ink-500 font-bold text-[11px] uppercase tracking-widest mb-3.5">BUTTON GROUP (E.G. SORTIEREN)</div>
      <div class="flex mb-10">
        <div class="btn-group" role="group">
          <button aria-pressed="false">Name</button>
          <button aria-pressed="true">Bewertung ↓</button>
          <button aria-pressed="false">Benutzer</button>
          <button aria-pressed="false">Alkohol</button>
          <button aria-pressed="false">Aufrufe</button>
        </div>
      </div>

      <div class="p-8 bg-cs-red-900 rounded-xl">
        <div class="text-cs-gold-400 uppercase tracking-widest mb-4 font-bold text-[10px]">On dark surfaces</div>
        <div class="flex flex-wrap gap-3">
          <button class="btn btn-gold">Rezepte entdecken</button>
          <button class="btn btn-outline-gold text-cs-ink-50 border-cs-ink-50/30 hover:border-cs-gold-300">Meine Bar</button>
          <button class="btn btn-ghost-dark">Später</button>
        </div>
      </div>
    </section>

    <!-- ================= 05 CARDS ================= -->
    <section id="cards" class="mb-20 scroll-mt-24">
      <div class="flex items-baseline justify-between gap-4 border-b border-cs-ink-200 pb-3 mb-6">
        <h2 class="m-0 font-display font-semibold text-4xl text-cs-red-900 tracking-tight">Cards</h2>
        <span class="font-mono text-cs-ink-500 text-xs uppercase tracking-widest">05</span>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="card">
          <div class="card-header">Standard Card</div>
          <div class="card-body">The default card container. White background, thin stroke, soft shadow.</div>
          <div class="card-footer text-cs-ink-500">Zuletzt aktualisiert · vor 3 Min.</div>
        </div>
        <div class="card card-elevated">
          <div class="card-header">Elevated Style <span class="tag tag-mini ml-1.5">Hover</span></div>
          <div class="card-body">Rises off the page — shadow-md depth without border.</div>
          <div class="card-footer">shadow-md · no border</div>
        </div>
        <div class="card card-ghost">
          <div class="card-header bg-transparent border-dashed">Empty State (Ghost)</div>
          <div class="card-body">
            <span class="text-cs-ink-400 italic">Noch keine Zutaten in deiner Bar — <a href="#" class="text-cs-blue-600 underline">jetzt hinzufügen</a>.</span>
          </div>
        </div>
        <div class="card card-gold">
          <div class="card-header">Gold Feature</div>
          <div class="card-body">Premium highlight for tips, editor's picks, or recommendations.</div>
          <div class="card-footer border-cs-gold-200 bg-cs-gold-50 text-cs-gold-800">Kuratiert von CocktailScout</div>
        </div>
        <div class="card card-dark">
          <div class="card-header border-cs-red-950 bg-cs-red-950 text-cs-gold-100 font-bold">Dark Feature</div>
          <div class="card-body text-cs-gold-100">
            Inverted look for stat tiles or promo callouts.
            <div class="flex gap-6 mt-5">
              <div><div class="font-display font-bold text-3xl text-cs-gold-400 leading-none mb-1">1.5k</div><div class="font-mono text-[9px] uppercase tracking-widest text-cs-gold-600 font-bold">Rezepte</div></div>
              <div><div class="font-display font-bold text-3xl text-cs-gold-400 leading-none mb-1">14k+</div><div class="font-mono text-[9px] uppercase tracking-widest text-cs-gold-600 font-bold">Mitglieder</div></div>
            </div>
          </div>
          <div class="card-footer bg-black/20 border-white/5 text-cs-gold-200/50">Community · täglich frisch</div>
        </div>
        <div class="card">
          <div class="card-header flex justify-between">Interactive Card
            <div class="flex gap-2">
              <button class="btn btn-ghost btn-sm p-1 h-6 w-6"><i class="fa-solid fa-pen scale-75"></i></button>
              <button class="btn btn-ghost btn-sm p-1 h-6 w-6"><i class="fa-solid fa-ellipsis scale-75"></i></button>
            </div>
          </div>
          <div class="card-body text-sm text-cs-ink-600 leading-relaxed">Card headers accept right-aligned action clusters for edit or overflow menus.</div>
        </div>
      </div>
    </section>

    <!-- ================= 06 TAGS ================= -->
    <section id="tags" class="mb-20 scroll-mt-24">
      <div class="flex items-baseline justify-between gap-4 border-b border-cs-ink-200 pb-3 mb-6">
        <h2 class="m-0 font-display font-semibold text-4xl text-cs-red-900 tracking-tight">Tags & Labels</h2>
        <span class="font-mono text-cs-ink-500 text-xs uppercase tracking-widest">06</span>
      </div>
      <div class="text-cs-ink-500 font-bold text-[11px] uppercase tracking-widest mb-3.5 mt-8">FILLED VARIANTS</div>
      <div class="flex flex-wrap gap-2.5 mb-10 text-inherit">
        <span class="tag tag-neutral">Neutral</span>
        <span class="tag tag-primary">Primary</span>
        <span class="tag tag-gold">Gold</span>
        <span class="tag tag-info">Info</span>
        <span class="tag tag-success">Active</span>
        <span class="tag tag-warning">Review</span>
        <span class="tag tag-error">Archiv</span>
      </div>

      <div class="text-cs-ink-500 font-bold text-[11px] uppercase tracking-widest mb-3.5">SOFT (RECIPE CATEGORIES)</div>
      <div class="flex flex-wrap gap-2.5 mb-10 text-inherit">
        <span class="tag tag-primary-soft">Klassiker</span>
        <span class="tag tag-gold-soft">Aperitif</span>
        <span class="tag tag-info">Longdrink</span>
        <span class="tag tag-success">Erfrischend</span>
        <span class="tag tag-warning">Stark</span>
        <span class="tag tag-neutral">Sauer</span>
      </div>

      <div class="text-cs-ink-500 font-bold text-[11px] uppercase tracking-widest mb-3.5">MINI / META</div>
      <div class="flex flex-wrap gap-2.5 text-inherit">
        <span class="tag-mini">IBA</span>
