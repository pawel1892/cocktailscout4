<!-- TWEAKS PANEL -->
<div id="tweaks" role="dialog" aria-label="Tweaks">
  <header><span>Tweaks</span><small>Design System v2</small></header>
  <div class="body">
    <label>Brand red <input id="tw-red" type="color" value="#360D0C" /></label>
    <label>Brand gold <input id="tw-gold" type="color" value="#CBB859" /></label>
    <label>Neutral hue <span class="val" id="tw-hue-v">28°</span><input id="tw-hue" type="range" min="0" max="60" value="28" /></label>
    <label>Neutral chroma <span class="val" id="tw-chroma-v">.014</span><input id="tw-chroma" type="range" min="0" max="40" value="14" /></label>
    <label>Radius <span class="val" id="tw-radius-v">6 / 10</span><input id="tw-radius" type="range" min="2" max="18" value="6" /></label>
    <div class="hint">Tokens regenerate live. Flip the toolbar toggle to hide.</div>
  </div>
</div>

<script>
function oklchToRgb(L, C, h) {
  const a = Math.cos(h * Math.PI / 180) * C;
  const b = Math.sin(h * Math.PI / 180) * C;
  const l_ = L + 0.3963377774 * a + 0.2158037573 * b;
  const m_ = L - 0.1055613458 * a - 0.0638541728 * b;
  const s_ = L - 0.0894841775 * a - 1.2914855480 * b;
  const l = l_ ** 3, m = m_ ** 3, s = s_ ** 3;
  let r = +4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s;
  let g = -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s;
  let bl = -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s;
  const toSrgb = (c) => c <= 0.0031308 ? 12.92 * c : 1.055 * Math.pow(c, 1/2.4) - 0.055;
  r = toSrgb(r); g = toSrgb(g); bl = toSrgb(bl);
  return [Math.max(0,Math.min(1,r)),Math.max(0,Math.min(1,g)),Math.max(0,Math.min(1,bl))];
}
function rgbToHex([r,g,b]){return '#'+[r,g,b].map(v=>Math.round(v*255).toString(16).padStart(2,'0')).join('').toUpperCase()}
function hexToRgb(hex){hex=hex.replace('#','');return [parseInt(hex.slice(0,2),16)/255,parseInt(hex.slice(2,4),16)/255,parseInt(hex.slice(4,6),16)/255]}
function rgbToOklch([r,g,b]){
  const toLin = c=>c<=.04045?c/12.92:Math.pow((c+.055)/1.055,2.4);
  r=toLin(r);g=toLin(g);b=toLin(b);
  const l=.4122214708*r+.5363325363*g+.0514459929*b;
  const m=.2119034982*r+.6806995451*g+.1073969566*b;
  const s=.0883024619*r+.2817188376*g+.6299787005*b;
  const l_=Math.cbrt(l),m_=Math.cbrt(m),s_=Math.cbrt(s);
  const L=.2104542553*l_+.7936177850*m_-.0040720468*s_;
  const a=1.9779984951*l_-2.4285922050*m_+.4505937099*s_;
  const b2=.0259040371*l_+.7827717662*m_-.8086757660*s_;
  const C=Math.sqrt(a*a+b2*b2);
  let h=Math.atan2(b2,a)*180/Math.PI;if(h<0)h+=360;
  return {L,C,h};
}

const LSTEPS = [0.985, 0.955, 0.90, 0.82, 0.72, 0.60, 0.49, 0.39, 0.30, 0.22, 0.12];
const STEPS  = [50,100,200,300,400,500,600,700,800,900,950];

function buildScale(anchorHex, anchorStepIdx){
  const {L: aL, C: aC, h} = rgbToOklch(hexToRgb(anchorHex));
  return LSTEPS.map((L, i) => {
    let C = aC;
    const dist = Math.abs(i - anchorStepIdx);
    C = aC * Math.max(0.25, 1 - dist * 0.12);
    if (i <= 1) C *= 0.35;
    if (i >= 10) C *= 0.55;
    const [r,g,b] = oklchToRgb(L, C, h);
    const hex = rgbToHex([r,g,b]);
    const lum = 0.2126*r + 0.7152*g + 0.0722*b;
    return {step: STEPS[i], hex, dark: lum < 0.55 ? 1 : 0};
  });
}

function renderScale(targetId, name, scale){
  const el = document.getElementById(targetId);
  if (!el) return;
  el.innerHTML = '';
  const row = document.createElement('div');
  row.className = 'scale-row';
  row.innerHTML = `<div class="scale-label">${name}<small>cs-${name.toLowerCase()}</small></div>`;
  scale.forEach(s => {
    row.innerHTML += `<div class="swatch" data-dark="${s.dark}" style="background:${s.hex}" title="Copy ${s.hex}" data-hex="${s.hex}">
      <span class="step">${s.step}</span>
      <span class="hex">${s.hex}</span>
    </div>`;
  });
  el.appendChild(row);
}

const state = { red: '#360D0C', gold: '#CBB859', link: '#2A6496', inkHue: 28, inkChroma: 0.014, radius: 6 };

function buildAll(){
  const redScale  = buildScale(state.red, 9);
  const goldScale = buildScale(state.gold, 5);
  const linkScale = buildScale(state.link, 5);
  const inkScale = LSTEPS.map((L, i) => {
    const h = state.inkHue;
    let C = state.inkChroma * (1 - Math.abs(i - 5) * 0.12);
    if (i <= 1) C *= 0.5;
    if (i >= 10) C *= 0.7;
    const [r,g,b] = oklchToRgb(L, Math.max(0, C), h);
    const hex = rgbToHex([r,g,b]);
    const lum = 0.2126*r + 0.7152*g + 0.0722*b;
    return {step: STEPS[i], hex, dark: lum < 0.55 ? 1 : 0};
  });

  renderScale('scale-red', 'Red',  redScale);
  renderScale('scale-gold','Gold', goldScale);
  renderScale('scale-link','Link', linkScale);
  renderScale('scale-ink', 'Ink',  inkScale);

  const root = document.documentElement;
  redScale.forEach(s  => root.style.setProperty(`--color-cs-red-${s.step}`,  s.hex));
  goldScale.forEach(s => root.style.setProperty(`--color-cs-gold-${s.step}`, s.hex));
  linkScale.forEach(s => root.style.setProperty(`--color-cs-link-${s.step}`, s.hex));
  inkScale.forEach(s  => root.style.setProperty(`--color-cs-ink-${s.step}`,  s.hex));

  root.style.setProperty('--ds-radius', state.radius + 'px');

  const dump = [
    '/* --- paste into @theme { ... } in application.css --- */',
    '',
    '/* Brand — Oxblood (Dark Red) */',
    ...redScale.map(s => `--color-cs-red-${s.step}: ${s.hex};`),
    '',
    '/* Brand — Brass (Gold) */',
    ...goldScale.map(s => `--color-cs-gold-${s.step}: ${s.hex};`),
    '',
    '/* Link — Blue */',
    ...linkScale.map(s => `--color-cs-link-${s.step}: ${s.hex};`),
    '',
    '/* Warm Neutral — Ink */',
    ...inkScale.map(s => `--color-cs-ink-${s.step}: ${s.hex};`),
    '',
    '/* Semantic */',
    '--color-cs-success-50: #E8F6EC;  --color-cs-success-100: #C7E8D1;  --color-cs-success-500: #16A34A;  --color-cs-success-700: #0D7A35;  --color-cs-success-900: #074720;',
    '--color-cs-warning-50: #FDF6DF;  --color-cs-warning-100: #FAE8A8;  --color-cs-warning-500: #CA8A04;  --color-cs-warning-700: #8D6002;  --color-cs-warning-900: #523701;',
    '--color-cs-error-50:   #FCECEC;  --color-cs-error-100:   #F6CACA;  --color-cs-error-500:   #DC2626;  --color-cs-error-700:   #A01818;  --color-cs-error-900:   #5C0A0A;',
    '--color-cs-info-50:    #EAF1F8;  --color-cs-info-100:    #CBDBEC;  --color-cs-info-500:    #2A6496;  --color-cs-info-700:    #1B4468;  --color-cs-info-900:    #0F293F;',
    '',
    '/* Aliases */',
    '--color-cs-dark-red: var(--color-cs-red-900);',
    '--color-cs-gold:     var(--color-cs-gold-500);',
    '--color-cs-link:     var(--color-cs-info-500);',
  ].join('\n');
  document.getElementById('token-dump').textContent = dump;
}

window.addEventListener('message', (e) => {
  if (!e?.data?.type) return;
  if (e.data.type === '__activate_edit_mode')   document.getElementById('tweaks').classList.add('on');
  if (e.data.type === '__deactivate_edit_mode') document.getElementById('tweaks').classList.remove('on');
});
window.parent.postMessage({type:'__edit_mode_available'}, '*');

const $ = (id) => document.getElementById(id);
$('tw-red').addEventListener('input',  e => { state.red  = e.target.value; buildAll(); });
$('tw-gold').addEventListener('input', e => { state.gold = e.target.value; buildAll(); });
$('tw-hue').addEventListener('input',  e => { state.inkHue = +e.target.value; $('tw-hue-v').textContent = state.inkHue + '°'; buildAll(); });
$('tw-chroma').addEventListener('input', e => { state.inkChroma = +e.target.value / 1000; $('tw-chroma-v').textContent = state.inkChroma.toFixed(3); buildAll(); });
$('tw-radius').addEventListener('input', e => { state.radius = +e.target.value; $('tw-radius-v').textContent = state.radius + ' / ' + (state.radius*1.6).toFixed(0); buildAll(); });

document.addEventListener('click', (e) => {
  const sw = e.target.closest('.swatch');
  if (!sw) return;
  const hex = sw.dataset.hex;
  navigator.clipboard?.writeText(hex);
  const prev = sw.querySelector('.hex').textContent;
  sw.querySelector('.hex').textContent = 'copied';
  setTimeout(() => sw.querySelector('.hex').textContent = prev, 900);
});

buildAll();
</script>
