<% content_for :full_bleed_page, true %>

<% content_for :head do %>
<style>
/* Design-system page chrome — not part of the shared system */
*,*::before,*::after{box-sizing:border-box}
.ds-body{font-family:'Inter',system-ui,sans-serif;background:var(--color-cs-ink-50);color:var(--color-cs-ink-900);-webkit-font-smoothing:antialiased;line-height:1.5}
.sg-topbar{display:flex;align-items:center;justify-content:space-between;padding:20px 32px;border-bottom:1px solid var(--color-cs-ink-200);background:var(--color-cs-ink-50);position:sticky;top:0;z-index:20;backdrop-filter:blur(8px)}
.sg-topbar h1{margin:0;font-family:var(--font-display),serif;font-weight:700;font-size:22px;letter-spacing:-.01em;color:var(--color-cs-red-900);display:flex;align-items:center;gap:10px}
.sg-topbar h1 .glyph{width:28px;height:28px;border-radius:50%;background:radial-gradient(circle at 30% 30%,var(--color-cs-gold-300),var(--color-cs-gold-600));box-shadow:inset 0 -2px 4px rgba(0,0,0,.2)}
.sg-topbar .meta{font-size:13px;color:var(--color-cs-ink-500);font-family:'JetBrains Mono',monospace}
.sg-wrap{max-width:1180px;margin:0 auto;padding:48px 32px 96px}
.sg-nav{display:flex;gap:4px;flex-wrap:wrap;margin:0 0 40px;padding:6px;background:var(--color-cs-ink-100);border-radius:10px;border:1px solid var(--color-cs-ink-200)}
.sg-nav a{padding:8px 14px;border-radius:6px;font-size:13px;font-weight:500;color:var(--color-cs-ink-700);text-decoration:none;transition:all .15s}
.sg-nav a:hover{background:var(--color-cs-ink-50);color:var(--color-cs-red-900)}
.sg-section{margin:0 0 72px;scroll-margin-top:88px}
.sg-section-head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin:0 0 24px;padding:0 0 12px;border-bottom:1px solid var(--color-cs-ink-200)}
.sg-section-head h2{margin:0;font-family:var(--font-display),serif;font-weight:700;font-size:30px;letter-spacing:-.015em;color:var(--color-cs-red-900)}
.sg-section-head .kbd{font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--color-cs-ink-500);text-transform:uppercase;letter-spacing:.12em}
.sg-lede{color:var(--color-cs-ink-600);font-size:14px;max-width:720px;margin:0 0 28px}
.sg-subhead{margin:32px 0 14px;font-family:'Inter',sans-serif;font-weight:600;font-size:13px;text-transform:uppercase;letter-spacing:.1em;color:var(--color-cs-ink-500)}
/* Color scales */
.scale-row{display:grid;grid-template-columns:120px repeat(11,1fr);gap:0;border-radius:10px;overflow:hidden;box-shadow:0 2px 4px rgba(24,21,19,.06);margin-bottom:10px;border:1px solid var(--color-cs-ink-200)}
.scale-label{background:#fff;padding:14px;font-size:12px;font-weight:600;color:var(--color-cs-ink-800);display:flex;align-items:center;border-right:1px solid var(--color-cs-ink-200);flex-direction:column;justify-content:center}
.scale-label small{display:block;font-weight:400;color:var(--color-cs-ink-500);font-family:'JetBrains Mono',monospace;font-size:10px;margin-top:2px}
.swatch{padding:14px 10px;min-height:78px;display:flex;flex-direction:column;justify-content:space-between;font-family:'JetBrains Mono',monospace;font-size:10px;cursor:pointer;transition:transform .15s}
.swatch:hover{transform:translateY(-2px);z-index:2;box-shadow:0 6px 14px -4px rgba(24,21,19,.12)}
.swatch .step{font-weight:600;font-size:11px}
.swatch .hex{opacity:.85}
.swatch[data-dark="0"]{color:#1a1310}
.swatch[data-dark="1"]{color:#fff}
/* Semantic grid */
.semantic-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:14px}
.sem-card{border-radius:10px;overflow:hidden;border:1px solid var(--color-cs-ink-200);background:#fff;box-shadow:0 1px 2px rgba(24,21,19,.06)}
.sem-card .bar{display:grid;grid-template-columns:1fr 1fr 1fr;height:58px}
.sem-card .bar div{display:flex;align-items:flex-end;justify-content:flex-start;padding:6px 8px;font-family:'JetBrains Mono',monospace;font-size:9px;color:#fff}
.sem-card .meta{padding:10px 12px;display:flex;justify-content:space-between;align-items:center;font-size:12px}
.sem-card .meta strong{color:var(--color-cs-ink-900)}
.sem-card .meta code{font-family:'JetBrains Mono',monospace;color:var(--color-cs-ink-500);font-size:11px}
/* Type specimens */
.type-row{display:grid;grid-template-columns:120px 1fr auto;gap:16px;align-items:baseline;padding:14px 0;border-bottom:1px solid var(--color-cs-ink-200)}
.type-row .lab{font:500 11px 'JetBrains Mono';color:var(--color-cs-ink-500);text-transform:uppercase;letter-spacing:.08em}
.type-row .sam{color:var(--color-cs-ink-900)}
.type-row .spec{font:400 11px 'JetBrains Mono';color:var(--color-cs-ink-500);text-align:right}
/* Hero preview */
.hero-preview{border-radius:12px;overflow:hidden;background:linear-gradient(90deg,rgba(54,13,12,.88) 0%,rgba(54,13,12,.78) 55%,rgba(54,13,12,.55) 100%),repeating-linear-gradient(135deg,var(--color-cs-red-950) 0 18px,var(--color-cs-red-900) 18px 36px);color:#fff;padding:40px;display:grid;grid-template-columns:1fr 1fr;gap:32px;align-items:center;box-shadow:0 18px 36px -12px rgba(24,21,19,.22);border:1px solid var(--color-cs-red-950);margin-bottom:72px}
.hero-preview .photo-ph{aspect-ratio:4/3;border-radius:10px;background:repeating-linear-gradient(45deg,rgba(255,255,255,.05) 0 12px,transparent 12px 24px),linear-gradient(135deg,var(--color-cs-red-800),var(--color-cs-red-950));display:flex;align-items:center;justify-content:center;color:var(--color-cs-gold-300);font:500 12px 'JetBrains Mono';letter-spacing:.12em;text-transform:uppercase;border:1px solid var(--color-cs-red-700)}
.hero-preview h2{font-family:var(--font-display),serif;font-weight:700;font-size:40px;line-height:1.05;letter-spacing:-.02em;color:var(--color-cs-gold-400);margin:0 0 14px}
.hero-preview p{color:rgba(255,255,255,.82);margin:0 0 22px;font-size:15px;line-height:1.55;max-width:380px}
.hero-preview .cta{display:flex;gap:10px;flex-wrap:wrap}
/* Grid helpers */
.grid-2{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.grid-4{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
@media(max-width:820px){.grid-2,.grid-3,.grid-4{grid-template-columns:1fr}}
/* Button row helper */
.btn-row{display:flex;gap:10px;flex-wrap:wrap;align-items:center;margin-bottom:16px}
/* Tag row helper */
.tag-row{display:flex;gap:6px;flex-wrap:wrap;align-items:center}
/* Cocktail card composite */
.cocktail-card{background:#fff;border:1px solid var(--color-cs-ink-200);border-radius:12px;display:grid;grid-template-columns:108px 1fr auto;gap:16px;padding:14px;align-items:center;box-shadow:0 2px 4px rgba(24,21,19,.06)}
.cocktail-card .thumb{width:100%;aspect-ratio:1;border-radius:8px;overflow:hidden;background:repeating-linear-gradient(45deg,var(--color-cs-ink-100) 0 8px,var(--color-cs-ink-50) 8px 16px);display:flex;align-items:center;justify-content:center;color:var(--color-cs-ink-400);font-size:22px}
.cocktail-card h4{margin:0 0 4px;font:700 16px 'Inter';color:var(--color-cs-info-500)}
.cocktail-card .author{font-size:12px;color:var(--color-cs-ink-500);margin-bottom:8px}
.cocktail-card .tags{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:6px}
.cocktail-card .stats{font-size:11px;color:var(--color-cs-ink-500);font-family:'JetBrains Mono',monospace}
.rating-chip{min-width:56px;text-align:center;font-weight:700;font-size:20px;padding:10px 8px;border-radius:8px;color:#fff;font-family:var(--font-display),serif}
.rating-chip.high{background:var(--color-cs-success-500)}
.rating-chip.mid{background:var(--color-cs-gold-600)}
.rating-chip.low{background:var(--color-cs-error-500)}
.rating-chip small{display:block;font:500 10px 'JetBrains Mono',monospace;opacity:.8;margin-top:2px}
/* Avatar */
.ds-avatar{width:36px;height:36px;border-radius:50%;background:radial-gradient(circle at 30% 30%,var(--color-cs-gold-300),var(--color-cs-gold-700));display:inline-flex;align-items:center;justify-content:center;color:var(--color-cs-red-950);font:700 14px 'Inter';border:2px solid #fff;box-shadow:0 1px 2px rgba(24,21,19,.06)}
/* Code block */
.ds-code{background:var(--color-cs-ink-900);color:var(--color-cs-gold-200);padding:14px 16px;border-radius:8px;font:400 12px/1.6 'JetBrains Mono',monospace;overflow-x:auto;white-space:pre;border:1px solid var(--color-cs-ink-950)}
/* Tweaks panel */
#tweaks{position:fixed;right:18px;bottom:18px;width:280px;z-index:50;background:#fff;border:1px solid var(--color-cs-ink-200);border-radius:12px;box-shadow:0 18px 36px -12px rgba(24,21,19,.22);overflow:hidden;display:none}
#tweaks.on{display:block}
#tweaks header{padding:10px 14px;background:var(--color-cs-red-900);color:var(--color-cs-gold-300);font:700 12px 'Inter';letter-spacing:.06em;text-transform:uppercase;display:flex;justify-content:space-between;align-items:center}
#tweaks header small{font:500 10px 'JetBrains Mono';color:var(--color-cs-gold-500);text-transform:none;letter-spacing:0}
#tweaks .body{padding:12px 14px;display:flex;flex-direction:column;gap:10px}
#tweaks label{font:600 11px 'Inter';color:var(--color-cs-ink-700);display:flex;justify-content:space-between;align-items:center}
#tweaks input[type="color"]{width:46px;height:26px;border:1px solid var(--color-cs-ink-200);padding:0;border-radius:4px;background:transparent;cursor:pointer}
#tweaks input[type="range"]{width:110px}
#tweaks .val{font:500 10px 'JetBrains Mono';color:var(--color-cs-ink-500)}
#tweaks .hint{font:400 11px 'Inter';color:var(--color-cs-ink-500);line-height:1.4;padding-top:4px;border-top:1px dashed var(--color-cs-ink-200);margin-top:2px}
</style>
<% end %>

<div class="ds-body">

<div class="sg-topbar">
  <h1><span class="glyph"></span> CocktailScout — Design System <span style="color:var(--color-cs-gold-600);font-weight:500">v2</span></h1>
  <span class="meta">/design-tokens.css · 2026.04</span>
</div>

<div class="sg-wrap">

  <p class="sg-lede">
    A fuller tonal system for CocktailScout — brand oxblood and brass each expanded into an 11-step scale,
    a warm neutral to replace flat gray, and semantic colors with light/base/dark triads.
    Components below are re-composed on top of these tokens so buttons, cards, tags, callouts and forms
    have real hover / pressed / muted states instead of relying on <code>opacity-80</code>.
  </p>

  <nav class="sg-nav">
    <a href="#colors">01 · Colors</a>
    <a href="#type">02 · Type</a>
    <a href="#links">03 · Links</a>
    <a href="#buttons">04 · Buttons</a>
    <a href="#cards">05 · Cards</a>
    <a href="#tags">06 · Tags</a>
    <a href="#callouts">07 · Callouts</a>
    <a href="#forms">08 · Forms</a>
    <a href="#tables">09 · Tables</a>
    <a href="#composite">10 · In-use</a>
    <a href="#tokens">11 · CSS tokens</a>
  </nav>

  <!-- HERO PREVIEW -->
  <section class="hero-preview">
    <div>
      <span class="tag tag-gold-soft" style="margin-bottom:14px">Design System v2</span>
      <h2>Scales, not single notes.</h2>
      <p>Brand oxblood and brass each get eleven steps — enough range for muted surfaces, confident accents, and deep nav chrome — without inventing new hues.</p>
      <div class="cta">
        <a class="btn btn-gold btn-lg" href="<%= recipes_path %>">Rezepte entdecken</a>
        <a class="btn btn-outline-gold btn-lg" href="#">Meine Bar</a>
      </div>
    </div>
    <div class="photo-ph">Bar photography</div>
  </section>

  <!-- ================= 01 COLORS ================= -->
  <section id="colors" class="sg-section">
    <div class="sg-section-head">
      <h2>Color</h2><span class="kbd">01</span>
    </div>
    <p class="sg-lede" style="margin-bottom:20px">
      Three tonal scales anchor everything. Brand anchors stay put: <code>red-900 = #360D0C</code>, <code>gold-500 = #CBB859</code>.
      The neutral is <em>warm</em> (slight red/amber undertone) so it reads as paper-and-ink under gold light, not blue-gray.
    </p>

    <div class="sg-subhead">Brand — Oxblood (Dark Red)</div>
    <div id="scale-red"></div>

    <div class="sg-subhead">Brand — Brass (Gold)</div>
    <div id="scale-gold"></div>

    <div class="sg-subhead">Warm Neutral — Ink</div>
    <div id="scale-ink"></div>

    <div class="sg-subhead">Link — Blue</div>
    <div id="scale-link"></div>

    <div class="sg-subhead">Semantic — Success · Warning · Error · Info</div>
    <div class="semantic-grid">
      <div class="sem-card">
        <div class="bar">
          <div style="background:var(--color-cs-success-100);color:var(--color-cs-success-900)">100</div>
          <div style="background:var(--color-cs-success-500)">500</div>
          <div style="background:var(--color-cs-success-900)">900</div>
        </div>
        <div class="meta"><strong>Success</strong><code>cs-success</code></div>
      </div>
      <div class="sem-card">
        <div class="bar">
          <div style="background:var(--color-cs-warning-100);color:var(--color-cs-warning-900)">100</div>
          <div style="background:var(--color-cs-warning-500)">500</div>
          <div style="background:var(--color-cs-warning-900)">900</div>
        </div>
        <div class="meta"><strong>Warning</strong><code>cs-warning</code></div>
      </div>
      <div class="sem-card">
        <div class="bar">
          <div style="background:var(--color-cs-error-100);color:var(--color-cs-error-900)">100</div>
          <div style="background:var(--color-cs-error-500)">500</div>
          <div style="background:var(--color-cs-error-900)">900</div>
        </div>
        <div class="meta"><strong>Error</strong><code>cs-error</code></div>
      </div>
      <div class="sem-card">
        <div class="bar">
          <div style="background:var(--color-cs-info-100);color:var(--color-cs-info-900)">100</div>
          <div style="background:var(--color-cs-info-500)">500</div>
          <div style="background:var(--color-cs-info-900)">900</div>
        </div>
        <div class="meta"><strong>Info / Link</strong><code>cs-info</code></div>
      </div>
    </div>
  </section>

  <!-- ================= 02 TYPE ================= -->
  <section id="type" class="sg-section">
    <div class="sg-section-head"><h2>Typography</h2><span class="kbd">02</span></div>
    <p class="sg-lede">
      <strong>Fraunces</strong> (display serif) for headings and ratings — evokes classic bar menus.
      <strong>Inter</strong> for UI and body copy. <strong>JetBrains&nbsp;Mono</strong> for token values, stats and counts.
    </p>
    <div>
      <div class="type-row">
        <span class="lab">Display</span>
        <span class="sam" style="font:900 44px/1 var(--font-display);letter-spacing:-.02em;color:var(--color-cs-red-900)">Cocktail Rezepte</span>
        <span class="spec">Fraunces 900 · 44/46</span>
      </div>
      <div class="type-row">
        <span class="lab">H1 / Hero</span>
        <span class="sam" style="font:700 34px var(--font-display);letter-spacing:-.015em;color:var(--color-cs-red-900)">Long Island Iced Tea</span>
        <span class="spec">Fraunces 700 · 34/40</span>
      </div>
      <div class="type-row">
        <span class="lab">H2</span>
        <span class="sam" style="font:700 24px var(--font-display);color:var(--color-cs-red-900)">Heute frisch gemixt</span>
        <span class="spec">Fraunces 700 · 24/32</span>
      </div>
      <div class="type-row">
        <span class="lab">H3 / Card</span>
        <span class="sam" style="font:600 18px 'Inter';color:var(--color-cs-ink-900)">Espresso Martini</span>
        <span class="spec">Inter 600 · 18/24</span>
      </div>
      <div class="type-row">
        <span class="lab">Body</span>
        <span class="sam" style="font:400 15px 'Inter';color:var(--color-cs-ink-800)">1.500+ Cocktail Rezepte — und mit Meine Bar siehst du sofort, was du mixen kannst.</span>
        <span class="spec">Inter 400 · 15/24</span>
      </div>
      <div class="type-row">
        <span class="lab">Small</span>
        <span class="sam" style="font:400 13px 'Inter';color:var(--color-cs-ink-600)">vor 19 Minuten · von Ripuli</span>
        <span class="spec">Inter 400 · 13/18</span>
      </div>
      <div class="type-row">
        <span class="lab">Mono / Stat</span>
        <span class="sam" style="font:500 13px 'JetBrains Mono';color:var(--color-cs-ink-700)">1.124.100 views · 14.3% ABV</span>
        <span class="spec">JBMono 500 · 13/18</span>
      </div>
      <div class="type-row">
        <span class="lab">Eyebrow</span>
        <span class="sam" style="font:600 11px 'Inter';color:var(--color-cs-ink-500);text-transform:uppercase;letter-spacing:.12em">KATEGORIE · KLASSIKER</span>
        <span class="spec">Inter 600 · 11/14 · 0.12em</span>
      </div>
    </div>
  </section>

  <!-- ================= 03 LINKS ================= -->
  <section id="links" class="sg-section">
    <div class="sg-section-head"><h2>Links</h2><span class="kbd">03</span></div>
    <p class="sg-lede">
      A dedicated blue scale (<code>cs-link-*</code>) anchored at <code>500&nbsp;=&nbsp;#2A6496</code> — the site's existing link blue, now with ten companion steps.
      The default state uses the muted <code>-600</code> step so hover can darken to <code>-700</code>. Underline appears on hover via border-bottom rather than text-decoration, so it stays sharp at any weight.
    </p>

    <div class="sg-subhead">Variants</div>
    <div style="background:#fff;border:1px solid var(--color-cs-ink-200);border-radius:10px;padding:22px;display:grid;grid-template-columns:1fr 1fr;gap:26px 40px;font-size:15px;line-height:1.7">
      <div>
        <div style="font:600 11px 'Inter';color:var(--color-cs-ink-500);text-transform:uppercase;letter-spacing:.1em;margin-bottom:10px">Default — <code>.link</code></div>
        <p>Unser <a href="#" class="link">Mojito-Rezept</a> ist heute dreimal so beliebt wie gestern. Alle Klassiker findest du <a href="#" class="link">in der Rezeptübersicht</a>.</p>
      </div>
      <div>
        <div style="font:600 11px 'Inter';color:var(--color-cs-ink-500);text-transform:uppercase;letter-spacing:.1em;margin-bottom:10px">Underline — <code>.link.link-underline</code></div>
        <p>Teil unserer <a href="#" class="link link-underline">Allgemeinen Geschäftsbedingungen</a> und <a href="#" class="link link-underline">Datenschutzerklärung</a> — auffälliger für Fließtext.</p>
      </div>
      <div>
        <div style="font:600 11px 'Inter';color:var(--color-cs-ink-500);text-transform:uppercase;letter-spacing:.1em;margin-bottom:10px">Muted — <code>.link.link-muted</code></div>
        <p>Breadcrumbs &amp; Footer: <a href="#" class="link link-muted">Startseite</a> › <a href="#" class="link link-muted">Rezepte</a> › <strong>Long Island Iced Tea</strong>.</p>
      </div>
      <div>
        <div style="font:600 11px 'Inter';color:var(--color-cs-ink-500);text-transform:uppercase;letter-spacing:.1em;margin-bottom:10px">Arrow — <code>.link-arrow</code></div>
        <p><a href="#" class="link-arrow">Alle Rezepte ansehen <span class="arr">→</span></a><br /><a href="#" class="link-arrow">Zur Community <span class="arr">→</span></a></p>
      </div>
      <div>
        <div style="font:600 11px 'Inter';color:var(--color-cs-ink-500);text-transform:uppercase;letter-spacing:.1em;margin-bottom:10px">Danger — <code>.link.link-danger</code></div>
        <p>Achtung: <a href="#" class="link link-danger">Konto löschen</a> oder <a href="#" class="link link-danger">Beitrag melden</a> — rot für destruktive Aktionen.</p>
      </div>
      <div style="background:var(--color-cs-red-900);margin:-22px -26px -22px 0;padding:18px 22px;border-radius:0 10px 10px 0;color:var(--color-cs-gold-100)">
        <div style="font:600 11px 'Inter';color:var(--color-cs-gold-500);text-transform:uppercase;letter-spacing:.1em;margin-bottom:10px">On dark — <code>.link-on-dark</code></div>
        <p>Im Footer oder auf dem Hero: <a href="#" class="link link-on-dark">Impressum</a>, <a href="#" class="link link-on-dark">Datenschutz</a>, <a href="#" class="link link-on-dark">Kontakt</a>.</p>
      </div>
    </div>

    <div class="sg-subhead">Button-shaped link — <code>.btn.btn-link</code></div>
    <p class="sg-lede" style="margin-bottom:12px">For actions that read as links but sit in a button row — spacing matches the rest of the button family.</p>
    <div class="btn-row">
      <button class="btn btn-primary">Speichern</button>
      <button class="btn btn-outline">Vorschau</button>
      <button class="btn btn-link">Abbrechen</button>
    </div>
  </section>

  <!-- ================= 04 BUTTONS ================= -->
  <section id="buttons" class="sg-section">
    <div class="sg-section-head"><h2>Buttons</h2><span class="kbd">04</span></div>
    <p class="sg-lede">
      Seven variants spanning the commitment ladder: <strong>primary</strong> (oxblood) for main actions,
      <strong>gold</strong> for the hero "go" moment, <strong>outline / soft / ghost</strong> for secondary weight,
      <strong>danger</strong> for destructive. Hovers use adjacent scale steps — no more <code>opacity-80</code>.
    </p>

    <div class="sg-subhead">Variants — default size</div>
    <div class="btn-row">
      <button class="btn btn-primary">Rezept speichern</button>
      <button class="btn btn-gold">Rezepte entdecken</button>
      <button class="btn btn-outline">Meine Bar</button>
      <button class="btn btn-soft">Zur Favoritenliste</button>
      <button class="btn btn-ghost">Abbrechen</button>
      <button class="btn btn-danger"><i class="fa-solid fa-trash"></i> Löschen</button>
      <button class="btn btn-link">Mehr erfahren</button>
      <button class="btn btn-primary" disabled>Disabled</button>
    </div>

    <div class="sg-subhead">Sizes</div>
    <div class="btn-row">
      <button class="btn btn-primary btn-sm">Filtern</button>
      <button class="btn btn-primary">Filtern</button>
      <button class="btn btn-primary btn-lg">Filtern</button>
    </div>

