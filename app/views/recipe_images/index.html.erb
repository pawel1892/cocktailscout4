<!-- Page header -->
<div class="flex items-start justify-between mb-6 gap-4">
  <div>
    <h1 class="font-display font-semibold text-[52px] leading-none tracking-tight text-cs-red-900">Cocktailgalerie</h1>
    <div class="w-10 h-0.5 bg-cs-gold-400 mt-3 mb-2.5"></div>
    <p class="text-sm text-cs-ink-500">
      <%= @pagy.count %> <%= RecipeImage.model_name.human(count: @pagy.count) %>
    </p>
  </div>
</div>

<!-- Filter row -->
<div class="mb-5 flex flex-wrap items-end gap-4">
  <%= form_with url: recipe_images_path, method: :get, class: "contents", data: { turbo_frame: "_top" } do |f| %>
    <div class="flex flex-col gap-1 min-w-[200px] flex-1">
      <%= f.label :q, "Rezeptname", class: "label-field" %>
      <div class="relative">
        <%= f.text_field :q, value: params[:q], placeholder: "Rezeptname suchen…", class: "input-field pl-8" %>
        <i class="fas fa-search absolute left-2.5 top-1/2 -translate-y-1/2 text-cs-ink-400 text-xs pointer-events-none"></i>
      </div>
    </div>
    <div class="flex flex-col gap-1 min-w-[180px] flex-1">
      <%= f.label :user_id, "Benutzer", class: "label-field" %>
      <user-autocomplete
        initial-username="<%= @filter_user&.username %>"
        initial-user-id="<%= params[:user_id] %>"
      ></user-autocomplete>
    </div>
    <%= f.submit "Filtern", class: "btn btn-primary self-end" %>
  <% end %>
</div>

<!-- Active filters -->
<% if params[:user_id].present? || params[:q].present? %>
  <div class="mb-5 flex flex-wrap items-center gap-1.5">
    <% if params[:q].present? %>
      <%= link_to recipe_images_path(params.permit(:user_id)), class: "tag-info gap-1.5" do %>
        Suche: <%= params[:q] %>
        <i class="fas fa-times text-[9px] opacity-60"></i>
      <% end %>
    <% end %>
    <% if @filter_user %>
      <%= link_to recipe_images_path(params.permit(:q)), class: "tag-info gap-1.5" do %>
        Benutzer: <%= @filter_user.username %>
        <i class="fas fa-times text-[9px] opacity-60"></i>
      <% end %>
    <% end %>
    <%= link_to "Alle löschen", recipe_images_path, class: "text-xs text-cs-ink-400 hover:text-cs-ink-700 underline ml-1" %>
  </div>
<% end %>

<!-- Top pagination -->
<% if @pagy.pages > 1 %>
  <div class="flex justify-center mb-6">
    <%== @pagy.series_nav %>
  </div>
<% end %>

<gallery-viewer id="gallery-viewer"></gallery-viewer>

<!-- Bottom pagination -->
<% if @pagy.pages > 1 %>
  <div class="flex justify-center py-8 border-t border-cs-ink-200 mt-6">
    <%== @pagy.series_nav %>
  </div>
<% end %>

<script>
  window.galleryImages = <%= raw @recipe_images.select { |image| image.image.attached? }.map { |image|
    {
      id: image.id,
      thumbnailUrl: url_for(image.image.variant(:medium)),
      largeUrl: url_for(image.image.variant(:large)),
      recipeTitle: image.recipe.title,
      recipeUrl: recipe_path(image.recipe),
      user: image.user && { id: image.user.id, username: image.user.username, rank: image.user.rank, avatar_url_small: image.user.avatar_path(:small) },
      uploadDate: l(image.created_at.to_date)
    }
  }.to_json %>;
</script>
