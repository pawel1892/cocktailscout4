<%= render 'forum/forum_header', active: :topic %>

<!-- Page header -->
<div class="mb-8 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
  <div>
    <h1 class="font-display font-semibold text-[52px] leading-none tracking-tight text-cs-red-900">Cocktailforum</h1>
    <div class="w-10 h-0.5 bg-cs-gold-400 mt-3 mb-2.5"></div>
    <p class="text-sm text-cs-ink-500">Diskutiere Cocktails, Zutaten und alles rund ums Mixen</p>
  </div>
  <%= form_tag forum_search_path, method: :get do %>
    <div class="flex gap-2 shrink-0">
      <div class="relative">
        <i class="fas fa-search absolute left-2.5 top-1/2 -translate-y-1/2 text-cs-ink-400 text-xs pointer-events-none"></i>
        <%= text_field_tag :q, params[:q], placeholder: "Forensuche…", class: "input-field pl-8 w-44" %>
      </div>
      <button class="btn btn-primary" type="submit">Suchen</button>
    </div>
  <% end %>
</div>

<!-- Topic list -->
<div class="space-y-3">
  <% @forum_topics.each do |forum_topic| %>
    <% is_unread = @unread_topic_ids&.include?(forum_topic.id) %>
    <div class="card">
      <div class="card-body">
        <div class="flex items-center gap-4">

          <!-- Icon -->
          <div class="w-10 h-10 rounded-lg flex items-center justify-center shrink-0 <%= is_unread ? 'bg-cs-red-100 unread-indicator' : 'bg-cs-ink-100' %>">
            <i class="fas fa-comments text-base <%= is_unread ? 'text-cs-red-700' : 'text-cs-ink-400' %>"></i>
          </div>

          <!-- Name + description -->
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <%= link_to forum_topic.name, forum_topic_path(forum_topic.slug), class: "font-display font-semibold text-[20px] text-cs-red-900 leading-tight hover:text-cs-red-700 transition-colors" %>
              <% if is_unread %>
                <span class="w-2 h-2 rounded-full bg-cs-red-700 shrink-0" title="Neue Beiträge"></span>
              <% end %>
            </div>
            <% if forum_topic.description.present? %>
              <p class="text-sm text-cs-ink-500 mt-0.5"><%= forum_topic.description %></p>
            <% end %>
          </div>

          <!-- Stats -->
          <div class="hidden sm:flex items-center gap-6 shrink-0 text-center">
            <div>
              <div class="font-mono font-medium text-[15px] text-cs-ink-900"><%= forum_topic.thread_count %></div>
              <div class="font-sans font-bold uppercase text-[10px] tracking-widest text-cs-ink-400">Themen</div>
            </div>
            <div>
              <div class="font-mono font-medium text-[15px] text-cs-ink-900"><%= forum_topic.post_count %></div>
              <div class="font-sans font-bold uppercase text-[10px] tracking-widest text-cs-ink-400">Beiträge</div>
            </div>
          </div>

          <!-- Last post -->
          <div class="hidden lg:block w-44 shrink-0 text-sm border-l border-cs-ink-100 pl-4">
            <% if forum_topic.last_post %>
              <div class="flex items-center gap-1.5 mb-1">
                <%= user_badge(forum_topic.last_post.user) %>
              </div>
              <div class="text-xs text-cs-ink-400">
                <i class="far fa-clock mr-1"></i><%= time_ago_in_words(forum_topic.last_post.created_at) %>
              </div>
            <% else %>
              <span class="text-cs-ink-400 text-sm italic">Keine Beiträge</span>
            <% end %>
          </div>

        </div>
      </div>
    </div>
  <% end %>
</div>
