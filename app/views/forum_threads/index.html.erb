<%= render "forum/forum_header", forum_topic: @forum_topic, active: :thread %>

<!-- Page header -->
<div class="mb-8 flex items-end justify-between gap-4">
  <div>
    <h1 class="font-display font-semibold text-[38px] leading-tight tracking-tight text-cs-red-900"><%= @forum_topic.name %></h1>
    <div class="w-10 h-0.5 bg-cs-gold-400 mt-3 mb-2.5"></div>
    <% if @forum_topic.description.present? %>
      <p class="text-sm text-cs-ink-500"><%= @forum_topic.description %></p>
    <% else %>
      <p class="text-sm text-cs-ink-500"><%= @pagy.count %> <%= @pagy.count == 1 ? 'Thema' : 'Themen' %></p>
    <% end %>
  </div>
  <% unless @forum_topic.news? && !current_user&.admin? %>
    <%= link_to new_forum_thread_path(@forum_topic), class: 'btn btn-primary shrink-0' do %>
      <i class="fas fa-plus text-xs mr-1.5"></i> Neues Thema
    <% end %>
  <% else %>
    <div class="text-sm text-cs-ink-400 italic flex items-center gap-1.5 shrink-0">
      <i class="fas fa-lock text-xs"></i> Nur Admins können hier posten
    </div>
  <% end %>
</div>

<!-- Pagination top -->
<% if @pagy.pages > 1 %>
  <div class="flex justify-center mb-6">
    <%== @pagy.series_nav %>
  </div>
<% end %>

<!-- Thread table -->
<div class="table-container">
  <table class="table-standard w-full">
    <thead>
      <tr>
        <th class="table-th">Thema</th>
        <th class="table-th text-right w-20 hidden sm:table-cell">Aufrufe</th>
        <th class="table-th text-right w-20 hidden sm:table-cell">Beiträge</th>
        <th class="table-th w-48">Letzter Beitrag</th>
      </tr>
    </thead>
    <tbody class="table-body">
      <% @forum_threads.each do |forum_thread| %>
        <% is_unread = current_user && forum_thread.last_post_created_at && forum_thread.last_post_created_at > (1.week.ago) && !forum_thread.read_by?(current_user) %>
        <tr class="table-tr-hover">
          <td class="table-td">
            <div class="flex items-center gap-3">
              <div class="w-5 shrink-0 text-center <%= is_unread ? 'text-cs-red-700' : 'text-cs-ink-300' %>">
                <% if forum_thread.sticky %>
                  <i class="fas fa-thumbtack text-cs-gold-500" title="Angepinnt"></i>
                <% elsif forum_thread.locked %>
                  <i class="fas fa-lock" title="Gesperrt"></i>
                <% else %>
                  <i class="fas fa-comment"></i>
                <% end %>
              </div>
              <div class="min-w-0">
                <%= link_to forum_thread.title, link_to_forum_thread(forum_thread), class: "font-medium text-cs-ink-900 hover:text-cs-red-900 transition-colors truncate block max-w-sm md:max-w-lg", title: forum_thread.title %>
                <div class="text-xs text-cs-ink-400 mt-0.5 flex items-center gap-1 flex-wrap">
                  Von <%= user_badge(forum_thread.user) %>
                  <span>&middot;</span>
                  <span><%= forum_thread.created_at.strftime("%d.%m.%Y") %></span>
                  <span class="sm:hidden">&middot; <%= forum_thread.count_posts %> Beiträge</span>
                </div>
              </div>
            </div>
          </td>
          <td class="table-td text-right font-mono text-[13px] text-cs-ink-600 hidden sm:table-cell">
            <%= forum_thread.views %>
          </td>
          <td class="table-td text-right font-mono text-[13px] text-cs-ink-600 hidden sm:table-cell">
            <%= forum_thread.count_posts %>
          </td>
          <td class="table-td">
            <% if forum_thread.last_post_user %>
              <div class="flex items-center gap-1.5 mb-1">
                <%= user_badge(forum_thread.last_post_user) %>
              </div>
              <div class="text-xs text-cs-ink-400">
                <i class="far fa-clock mr-1"></i><%= time_ago_in_words(forum_thread.last_post_created_at) %>
              </div>
            <% else %>
              <span class="text-cs-ink-400 text-sm italic">–</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<!-- Bottom pagination -->
<% if @pagy.pages > 1 %>
  <div class="flex justify-center py-6 border-t border-cs-ink-200 mt-4">
    <%== @pagy.series_nav %>
  </div>
<% end %>

<% unless @forum_topic.news? && !current_user&.admin? %>
  <div class="mt-6">
    <%= link_to new_forum_thread_path(@forum_topic), class: 'btn btn-outline' do %>
      <i class="fas fa-plus text-xs mr-1.5"></i> Neues Thema erstellen
    <% end %>
  </div>
<% end %>
