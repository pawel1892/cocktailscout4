<% content_for :title, "Rezept vorschlagen - CocktailScout" %>

<!-- Back link -->
<div class="mb-6">
  <%= link_to recipe_suggestions_path, class: "link inline-flex items-center gap-1.5 text-sm font-medium" do %>
    <i class="fas fa-arrow-left text-xs"></i>
    Zurück zur Übersicht
  <% end %>
</div>

<!-- Page header -->
<div class="mb-8">
  <h1 class="font-display font-semibold text-[38px] leading-tight tracking-tight text-cs-red-900">Rezept vorschlagen</h1>
  <div class="w-10 h-0.5 bg-cs-gold-400 mt-3 mb-2.5"></div>
  <p class="text-sm text-cs-ink-500">Teile dein Lieblingsrezept mit der Community</p>
</div>

<!-- Info callout -->
<div class="callout-info mb-6">
  <i class="fas fa-circle-info"></i>
  <div class="text-sm">
    <p class="font-semibold mb-1">So geht's</p>
    <ol class="list-decimal ml-4 space-y-0.5">
      <li>Fülle alle Details aus — Titel, Beschreibung, Tags und Zutaten</li>
      <li>Ein Moderator prüft deinen Vorschlag</li>
      <li>Bei Genehmigung erscheint dein Rezept mit deinem Namen als Autor</li>
      <li>Du kannst deinen Vorschlag jederzeit bearbeiten, solange er noch nicht geprüft wurde</li>
    </ol>
  </div>
</div>

<!-- Errors -->
<% if @errors.present? %>
  <div class="callout-red mb-6">
    <i class="fas fa-exclamation-triangle"></i>
    <ul class="list-disc ml-4 text-sm space-y-0.5">
      <% @errors.each do |error| %>
        <li><%= error %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<div class="card">
  <div class="card-body">
    <%= form_with url: recipe_suggestions_path, method: :post, local: true do |form| %>
      <recipe-form
        :initial-data='<%= raw @recipe_suggestion_form_data.to_json %>'
        :units='<%= raw Unit.order(:category, :name).map { |u| { id: u.id, name: u.name, display_name: u.display_name, plural_name: u.plural_name, category: u.category, divisible: u.divisible } }.to_json %>'
        form-name="recipe_suggestion"
      ></recipe-form>
    <% end %>
  </div>
</div>
