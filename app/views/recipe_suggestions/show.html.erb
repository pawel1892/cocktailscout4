<% content_for :title, "#{@suggestion.title} - Rezeptvorschlag - CocktailScout" %>

<!-- Back link -->
<div class="mb-6">
  <%= link_to recipe_suggestions_path, class: "link inline-flex items-center gap-1.5 text-sm font-medium" do %>
    <i class="fas fa-arrow-left text-xs"></i>
    Zurück zur Übersicht
  <% end %>
</div>

<!-- Page header -->
<div class="mb-8 flex items-start justify-between gap-4">
  <div>
    <h1 class="font-display font-semibold text-[38px] leading-tight tracking-tight text-cs-red-900"><%= @suggestion.title %></h1>
    <div class="w-10 h-0.5 bg-cs-gold-400 mt-3 mb-2.5"></div>
    <div class="flex flex-wrap items-center gap-3">
      <%= render "shared/suggestion_status_badge", suggestion: @suggestion %>
      <span class="text-xs text-cs-ink-400"><i class="fas fa-calendar mr-1"></i>Eingereicht <%= l(@suggestion.created_at, format: :short) %></span>
      <% if @suggestion.reviewed_at %>
        <span class="text-xs text-cs-ink-400"><i class="fas fa-check mr-1"></i>Geprüft <%= l(@suggestion.reviewed_at, format: :short) %></span>
      <% end %>
    </div>
  </div>
  <% if @suggestion.editable_by?(Current.user) %>
    <%= link_to edit_recipe_suggestion_path(@suggestion), class: "btn btn-primary shrink-0" do %>
      <i class="fas fa-pen text-xs mr-1.5"></i> Bearbeiten
    <% end %>
  <% end %>
</div>

<!-- Feedback / published notice -->
<% if @suggestion.status_rejected? && @suggestion.feedback.present? %>
  <div class="callout-red mb-6">
    <i class="fas fa-exclamation-triangle"></i>
    <div>
      <p class="font-semibold mb-1">Ablehnungsgrund</p>
      <div class="text-sm"><%= simple_format(@suggestion.feedback) %></div>
    </div>
  </div>
<% end %>

<% if @suggestion.status_approved? && @suggestion.published_recipe %>
  <div class="callout-success mb-6">
    <i class="fas fa-check-circle"></i>
    <div>
      <p class="font-semibold mb-1">Veröffentlicht als</p>
      <%= link_to recipe_path(@suggestion.published_recipe.slug), class: "link font-medium" do %>
        <%= @suggestion.published_recipe.title %>
        <i class="fas fa-arrow-right ml-1 text-xs"></i>
      <% end %>
    </div>
  </div>
<% end %>

<% if @suggestion.reviewed_by %>
  <div class="mb-6 text-xs text-cs-ink-400">
    Geprüft von <strong class="text-cs-ink-600"><%= @suggestion.reviewed_by.username %></strong>
  </div>
<% end %>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <!-- Main content -->
  <div class="lg:col-span-2 space-y-6">

    <!-- Description -->
    <div class="card">
      <div class="card-header">
        <span class="font-sans font-bold uppercase text-[11px] tracking-widest text-cs-ink-400">Beschreibung</span>
      </div>
      <div class="card-body prose prose-sm max-w-none text-cs-ink-800">
        <%= simple_format(@suggestion.description) %>
      </div>
    </div>

    <!-- Tags -->
    <% if @suggestion.tag_list.present? %>
      <div class="card">
        <div class="card-header">
          <span class="font-sans font-bold uppercase text-[11px] tracking-widest text-cs-ink-400">Tags</span>
        </div>
        <div class="card-body">
          <div class="flex flex-wrap gap-1.5">
            <% @suggestion.tag_list.split(',').map(&:strip).each do |tag| %>
              <span class="tag-neutral"><%= tag %></span>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

  </div>

  <!-- Ingredients sidebar -->
  <div class="card h-fit">
    <div class="card-header">
      <span class="font-sans font-bold uppercase text-[11px] tracking-widest text-cs-ink-400">Zutaten</span>
      <span class="font-mono text-[11px] text-cs-ink-400"><%= @suggestion.recipe_suggestion_ingredients.count %></span>
    </div>
    <div class="card-body p-0">
      <ul class="divide-y divide-cs-ink-100">
        <% @suggestion.recipe_suggestion_ingredients.each do |rsi| %>
          <li class="flex items-baseline gap-2 px-[18px] py-3 text-sm">
            <span class="font-mono text-[12px] text-cs-ink-500 shrink-0 w-16 text-right">
              <% if rsi.amount && rsi.unit %>
                <%= rsi.amount %> <%= rsi.unit.display_name_for(rsi.amount) %>
              <% elsif rsi.amount %>
                <%= rsi.amount %>×
              <% end %>
            </span>
            <span class="text-cs-ink-900">
              <%= rsi.display_name.presence || rsi.ingredient.name %>
              <% if rsi.additional_info.present? %>
                <span class="text-cs-ink-400 text-xs">(<%= rsi.additional_info %>)</span>
              <% end %>
              <% if rsi.is_optional %>
                <span class="text-cs-ink-400 text-xs italic">optional</span>
              <% end %>
            </span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>

</div>
