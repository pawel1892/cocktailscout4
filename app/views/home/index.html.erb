<% content_for :head do %>
  <%= website_structured_data %>
<% end %>
<% content_for :full_bleed_page, true %>

<!-- ═══════════════════════════════════════
     HERO C — full-bleed bg, contained content
     ═══════════════════════════════════════ -->
<section class="relative overflow-hidden">
  <!-- Full-width split backgrounds -->
  <div class="absolute inset-0 bg-cs-red-950 pointer-events-none"></div>
  <div class="absolute inset-y-0 right-0 bg-cs-ink-50 border-l border-cs-ink-200 pointer-events-none hidden lg:block"
       style="left: min(58.333vw, calc((100vw - 1180px) / 2 + 688px))"></div>

  <!-- Contained content grid — matches max-w-[1180px] sections below -->
  <div class="max-w-[1180px] mx-auto w-full lg:grid relative z-10"
       style="grid-template-columns: 1.4fr 1fr">

    <!-- Left: dark oxblood text — drives section height -->
    <div class="text-white flex flex-col justify-between px-10 py-14 lg:px-16 lg:py-16 relative overflow-hidden">
      <div class="absolute -right-36 -top-36 w-[440px] h-[440px] rounded-full pointer-events-none"
           style="background: radial-gradient(circle at 35% 35%, rgba(203,184,89,.18), transparent 70%)"></div>
      <div class="relative z-10">
        <div class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[.22em] text-cs-gold-400 mb-8">
          <span class="w-7 h-px bg-cs-gold-500 shrink-0"></span>
          Cocktail Rezepte · seit 2003
        </div>
        <h1 class="font-display font-medium text-[clamp(3.5rem,7vw,6.5rem)] leading-[.9] tracking-[-0.025em] text-cs-gold-300 m-0 mb-6">
          Mixed<em class="block not-italic italic text-white font-normal">by design.</em>
        </h1>
        <p class="text-[16px] text-cs-ink-200 leading-relaxed max-w-[460px] m-0">
          Über 1.500 handgepflegte Rezepte, echte Community-Ratings, und eine Bar, die sich merkt, was bei dir zuhause steht.
        </p>
      </div>
      <div class="relative z-10 flex gap-2.5 mt-9 flex-wrap">
        <%= link_to "Rezepte entdecken", recipes_path, class: "btn btn-gold" %>
        <%= link_to "Meine Bar →", my_bar_path, class: "btn btn-outline-gold" %>
      </div>
    </div>

    <!-- Right: featured recipe — hidden on mobile, stretches to left panel height on desktop -->
    <% if @featured_image && @featured_image.image.attached? %>
      <div class="hidden lg:flex flex-col gap-4 px-12 py-10">
        <div class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[.22em] text-cs-ink-500">
          <span class="w-7 h-px bg-cs-ink-400 shrink-0"></span>
          Rezept Highlight
        </div>
        <div class="flex-1 relative rounded-lg overflow-hidden min-h-[160px]">
          <%= image_tag @featured_image.image.variant(:large),
                class: "absolute inset-0 w-full h-full object-cover block",
                alt: @featured_image.recipe.title %>
        </div>
        <h3 class="font-display font-semibold text-[clamp(1.5rem,2.5vw,2rem)] text-cs-red-900 leading-[1.05] tracking-[-0.01em] m-0">
          <%= @featured_image.recipe.title %>
        </h3>
        <%= link_to "Zum Rezept →", recipe_path(@featured_image.recipe.slug), class: "btn btn-primary btn-sm self-start" %>
      </div>
    <% end %>

  </div>
</section>

<!-- ═══════════════════════════════════════
     TOP REZEPTE — Card B list
     ═══════════════════════════════════════ -->
<% if @top_recipes.any? %>
<section class="py-[72px]">
  <div class="max-w-[1180px] mx-auto px-10">
    <div class="flex items-baseline justify-between gap-4 mb-2">
      <h2 class="font-display font-semibold text-[40px] text-cs-red-900 tracking-[-0.012em] m-0">Top Rezepte</h2>
      <%= link_to "Alle Rezepte →", recipes_path(sort: "rating"), class: "text-[13px] text-cs-red-700 font-medium no-underline hover:underline shrink-0" %>
    </div>
    <p class="text-cs-ink-600 text-sm mb-7 mt-0">Die beliebtesten Cocktails der Community.</p>
    <div class="flex flex-col gap-3">
      <% @top_recipes.each do |recipe| %>
        <div class="card-b">
          <div class="thumb">
            <%= recipe_thumbnail(recipe, size_class: "w-full h-full") %>
            <% r = recipe.average_rating.to_f %>
            <span class="rating-badge <%= r >= 8.0 ? 'high' : r >= 6.5 ? 'mid' : 'low' %>">
              <%= number_with_precision(r, precision: 1, separator: ",") %><small><%= recipe.ratings_count %></small>
            </span>
          </div>
          <div class="body">
            <div class="title-row">
              <%= link_to recipe.title, recipe_path(recipe.slug), class: "name" %>
              <% if recipe.alcohol_content.present? && recipe.alcohol_content > 0 %>
                <span class="abv"><%= number_with_precision(recipe.alcohol_content, precision: 1) %>% ABV</span>
              <% end %>
            </div>
            <% if recipe.description.present? %>
              <p class="desc"><%= recipe.description %></p>
            <% end %>
            <div class="foot">
              <div class="tags">
                <% recipe.tags.first(3).each do |tag| %>
                  <span class="t"><%= tag.name %></span>
                <% end %>
              </div>
              <span class="dot">·</span>
              <span><%= number_with_delimiter(recipe.visits_count) %> Aufrufe</span>
              <span class="dot">·</span>
              <span>von <%= recipe.user.username %></span>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<!-- ═══════════════════════════════════════
     COMMUNITY
     ═══════════════════════════════════════ -->
<script>window.activityStream = <%= raw @activity_stream.to_json %>;</script>
<section class="bg-white border-t border-b border-cs-ink-200">
  <div class="max-w-[1180px] mx-auto px-10 py-[72px]">
    <div class="flex items-baseline justify-between gap-4 mb-2">
      <h2 class="font-display font-semibold text-[40px] text-cs-red-900 tracking-[-0.012em] m-0">Community</h2>
      <%= link_to "Alle Aktivitäten →", community_path, class: "text-[13px] text-cs-red-700 font-medium no-underline hover:underline shrink-0" %>
    </div>
    <p class="text-cs-ink-600 text-sm mb-7 mt-0">Was gerade bei CocktailScout passiert.</p>
    <activity-stream compact></activity-stream>
  </div>
</section>

<!-- ═══════════════════════════════════════
     NEUIGKEITEN — 3-column news cards
     ═══════════════════════════════════════ -->
<% if @news_threads.any? %>
<section class="py-[72px]">
  <div class="max-w-[1180px] mx-auto px-10">
    <div class="flex items-baseline justify-between gap-4 mb-2">
      <h2 class="font-display font-semibold text-[40px] text-cs-red-900 tracking-[-0.012em] m-0">Neuigkeiten</h2>
    </div>
    <p class="text-cs-ink-600 text-sm mb-7 mt-0">Was sich auf CocktailScout zuletzt getan hat.</p>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[18px]">
      <% @news_threads.each do |thread| %>
        <article class="news-card">
          <div class="news-date"><%= thread.created_at.strftime("%-d. %b %Y") %></div>
          <h4><%= thread.title %></h4>
          <%= link_to "Weiterlesen →", forum_thread_path(thread), class: "news-more" %>
        </article>
      <% end %>
    </div>
  </div>
</section>
<% end %>

<!-- ═══════════════════════════════════════
     MEINE BAR — ingredient picker + mini-stack
     ═══════════════════════════════════════ -->
<section class="bg-cs-red-950 relative overflow-hidden py-[72px]">
  <div class="absolute -right-[200px] -top-[160px] w-[560px] h-[560px] rounded-full pointer-events-none" style="background: radial-gradient(circle at 35% 35%, rgba(203,184,89,.12), transparent 70%)"></div>
  <div class="absolute -left-[140px] -bottom-[140px] w-[380px] h-[380px] rounded-full pointer-events-none" style="background: radial-gradient(circle at 35% 35%, rgba(142,61,55,.3), transparent 70%)"></div>

  <div class="max-w-[1180px] mx-auto px-10 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-[1.1fr_.9fr] gap-10 lg:gap-[72px] items-center">

      <!-- Left: text + picker card -->
      <div>
        <div class="flex items-center gap-3 font-mono text-[11px] uppercase tracking-[.22em] text-cs-gold-400 mb-5">
          <span class="w-7 h-px bg-cs-gold-500 shrink-0"></span>
          Dein persönlicher Barbegleiter
        </div>
        <h2 class="font-display font-medium text-[clamp(2.5rem,5vw,4rem)] leading-[.98] tracking-[-0.02em] text-cs-gold-300 m-0 mb-5">
          Was kannst du<br><em class="not-italic italic text-white font-normal">heute mixen?</em>
        </h2>
        <p class="text-[15px] text-cs-ink-200 leading-relaxed max-w-[440px] mb-7">
          Gib ein, was in deiner Bar steht. Wir zeigen dir sofort die Drinks, die du daraus machen kannst — inklusive Tipps, wenn dir nur eine Zutat fehlt.
        </p>

        <!-- Picker card (visual decoration) -->
        <div class="bg-white text-cs-ink-900 rounded-xl p-[22px] shadow-[0_20px_48px_-20px_rgba(0,0,0,.45)]">
          <div class="font-mono text-[10.5px] uppercase tracking-[.18em] text-cs-ink-500 mb-2.5">Zutaten in deiner Bar</div>
          <div class="flex gap-2 flex-wrap p-2.5 bg-cs-ink-50 border border-cs-ink-200 rounded-lg mb-3.5 min-h-[48px] items-center">
            <span class="inline-flex items-center gap-1.5 px-2.5 py-[5px] rounded-full bg-cs-red-900 text-cs-gold-300 text-[13px] font-medium">Gin</span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-[5px] rounded-full bg-cs-red-900 text-cs-gold-300 text-[13px] font-medium">Tonic</span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-[5px] rounded-full bg-cs-red-900 text-cs-gold-300 text-[13px] font-medium">Limette</span>
            <span class="inline-flex items-center gap-1.5 px-2.5 py-[5px] rounded-full bg-cs-red-900 text-cs-gold-300 text-[13px] font-medium">Zucker</span>
          </div>
          <div class="font-mono text-[11.5px] uppercase tracking-[.1em] text-cs-ink-500 mb-2.5">Schnell hinzufügen</div>
          <div class="flex gap-1.5 flex-wrap mb-[18px]">
            <span class="text-[12.5px] px-[11px] py-[5px] rounded-full border border-dashed border-cs-ink-300 text-cs-ink-700 bg-white">+ Wodka</span>
            <span class="text-[12.5px] px-[11px] py-[5px] rounded-full border border-dashed border-cs-ink-300 text-cs-ink-700 bg-white">+ Rum</span>
            <span class="text-[12.5px] px-[11px] py-[5px] rounded-full border border-dashed border-cs-ink-300 text-cs-ink-700 bg-white">+ Minze</span>
            <span class="text-[12.5px] px-[11px] py-[5px] rounded-full border border-dashed border-cs-ink-300 text-cs-ink-700 bg-white">+ Campari</span>
          </div>
          <div class="flex items-center justify-between gap-3.5 px-4 py-3.5 bg-cs-red-50 border border-cs-red-100 rounded-lg">
            <div>
              <strong class="font-display font-semibold text-[26px] text-cs-red-900 tracking-[-0.01em] block leading-none">1.500+ Rezepte</strong>
              <div class="text-[12.5px] text-cs-ink-600 mt-1.5">entdecke, was du mixen kannst</div>
            </div>
            <%= link_to "Meine Bar öffnen →", my_bar_path, class: "btn btn-primary shrink-0" %>
          </div>
        </div>
      </div>

      <!-- Right: mini-stack of recipe cards -->
      <% if @top_recipes.any? %>
        <div class="hidden lg:block">
          <div class="grid grid-cols-2 gap-4" style="grid-auto-rows: 190px">
            <% (@top_recipes.to_a + [nil]).first(4).each_with_index do |recipe, i| %>
              <% if recipe %>
                <div class="mini-stack-card bg-white rounded-xl overflow-hidden shadow-[0_12px_24px_-12px_rgba(0,0,0,.4)] flex flex-col cursor-pointer">
                  <div class="overflow-hidden bg-cs-ink-200" style="height: 115px">
                    <%= recipe_thumbnail(recipe, size_class: "w-full h-full") %>
                  </div>
                  <div class="px-3 py-2.5 flex flex-col gap-1 flex-1">
                    <b class="font-display font-semibold text-[17px] text-cs-red-900 leading-[1.1] tracking-[-0.01em] line-clamp-2"><%= recipe.title %></b>
                    <small class="font-mono text-[10px] text-cs-ink-500">
                      <%= number_with_precision(recipe.average_rating.to_f, precision: 1, separator: ",") %><% if recipe.alcohol_content.present? && recipe.alcohol_content > 0 %> · <%= number_with_precision(recipe.alcohol_content, precision: 0) %>% ABV<% end %>
                    </small>
                  </div>
                </div>
              <% else %>
                <div class="mini-stack-card bg-cs-ink-100 rounded-xl overflow-hidden flex flex-col opacity-60">
                  <div class="flex-1 bg-cs-ink-200 flex items-center justify-center text-cs-ink-400 font-mono text-[9px] uppercase tracking-wider" style="height: 115px">Mehr →</div>
                  <div class="px-3 py-2.5">
                    <b class="font-display text-[17px] text-cs-ink-400">…</b>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════
     ABOUT — 2-column grid + sidebar
     ═══════════════════════════════════════ -->
<section class="py-[72px]">
  <div class="max-w-[1180px] mx-auto px-10">
    <div class="grid grid-cols-1 lg:grid-cols-[1.3fr_1fr] gap-12 items-start">

      <!-- Left: about text -->
      <div>
        <div class="flex items-center gap-3 font-mono text-[10.5px] uppercase tracking-[.22em] text-cs-gold-700 mb-3">
          <span class="w-5 h-px bg-cs-gold-600 shrink-0"></span>
          Über CocktailScout
        </div>
        <h3 class="font-display font-semibold text-[32px] text-cs-red-900 tracking-[-0.01em] m-0 mb-3.5 leading-tight">
          Entstanden 2003 aus einer kleinen Frustration
        </h3>
        <p class="text-cs-ink-700 text-[14.5px] leading-[1.65] m-0 mb-3.5">
          Die schönsten Cocktail-Bücher waren entweder zu teuer, auf Englisch, oder die halbe Zutatenliste fehlte.
          Also starteten wir — aus dem Protestgedanken heraus, dass
          <em>„Was brauche ich für diesen Drink?"</em> eine einfach zu beantwortende Frage sein sollte.
        </p>
        <p class="text-cs-ink-700 text-[14.5px] leading-[1.65] m-0 mb-3.5">
          Heute pflegen wir über 1.500 <%= link_to "Cocktail-Rezepte", recipes_path, class: "link-underline font-medium" %>,
          eine lebendige <%= link_to "Community", community_path, class: "link-underline font-medium" %>, und
          <%= link_to "Meine Bar", my_bar_path, class: "link-underline font-medium" %> — das Feature, das dir zeigt, was du aus deinem Hausvorrat mixen kannst.
          Wir sind <%= link_to "Open Source", "https://github.com/pawel1892/cocktailscout4", class: "link-underline font-medium" %>, werbefrei und leben vom Beitrag unserer User.
        </p>
        <p class="text-cs-ink-700 text-[14.5px] leading-[1.65] m-0 mb-3.5">
          Wer programmieren kann: CocktailScout ist ein Open-Source-Projekt. Wer möchte, kann Code beisteuern und die Seite direkt besser machen.
        </p>
        <div class="flex gap-2.5 mt-5">
          <%= link_to "Rezepte entdecken", recipes_path, class: "btn btn-primary" %>
          <%= link_to "Community →", community_path, class: "btn btn-outline" %>
        </div>
      </div>

      <!-- Right: sidebar recipe card -->
      <% if @featured_image && @featured_image.image.attached? %>
        <aside class="about-side">
          <div class="flex items-center gap-2 font-mono text-[10.5px] uppercase tracking-[.22em] text-cs-gold-700 mb-2.5">
            <span class="w-5 h-px bg-cs-gold-600 shrink-0"></span>
            Rezept-Highlight
          </div>
          <div class="w-full h-40 rounded-lg overflow-hidden mb-3.5">
            <%= image_tag @featured_image.image.variant(:large), class: "w-full h-full object-cover block", alt: @featured_image.recipe.title %>
          </div>
          <h4 class="font-display font-semibold text-[22px] text-cs-red-900 tracking-[-0.01em] m-0 mb-1 leading-snug"><%= @featured_image.recipe.title %></h4>
          <div class="font-mono text-[11px] text-cs-ink-500 mb-3">
            von <%= @featured_image.recipe.user.username %>
            <% if @featured_image.recipe.average_rating.to_f > 0 %>
              · <%= number_with_precision(@featured_image.recipe.average_rating.to_f, precision: 1, separator: ",") %> ★
            <% end %>
          </div>
          <%= link_to "Zum Rezept →", recipe_path(@featured_image.recipe.slug), class: "btn btn-outline w-full justify-center" %>
        </aside>
      <% end %>

    </div>
  </div>
</section>
