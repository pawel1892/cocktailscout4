<% content_for :head do %>
  <%= website_structured_data %>
<% end %>
<% content_for :full_bleed_page, true %>

<!-- HERO — stacked on mobile, side-by-side from md -->
<div class="w-full flex flex-col lg:flex-row bg-cs-dark-red">
  <!-- Image: always natural 3:2 aspect ratio -->
  <div class="w-full lg:w-1/2 overflow-hidden">
    <picture>
      <source media="(min-width: 1920px)" srcset="/images/startpage/hero1-3840.jpg">
      <source media="(min-width: 1024px)" srcset="/images/startpage/hero1-1920.jpg">
      <source media="(min-width: 640px)"  srcset="/images/startpage/hero1-1024.jpg">
      <img src="/images/startpage/hero1-640.jpg" alt="Cocktail Rezepte" class="w-full block" fetchpriority="high">
    </picture>
  </div>
  <!-- Content -->
  <div class="w-full lg:w-1/2 flex items-center justify-center px-8 py-10 md:px-10 md:py-6 xl:px-14 xl:py-8">
    <div class="w-full max-w-xl text-center md:text-left">
      <h1 class="hero-h1 font-bold tracking-tight text-cs-gold mb-4 font-serif">
        Cocktail Rezepte &amp; deine persönliche Bar
      </h1>
      <p class="mt-4 text-lg leading-7 text-white/80">
        1.500+ Cocktail Rezepte — und mit <strong class="text-white">Meine Bar</strong> siehst du sofort, was du mit deinen Zutaten mixen kannst.
      </p>
      <div class="mt-8 flex flex-wrap gap-4 justify-center md:justify-start">
        <%= link_to "Rezepte entdecken", recipes_path, class: "btn btn-gold px-7 py-3 text-base shadow-lg" %>
        <%= link_to "Meine Bar", my_bar_path, class: "btn px-7 py-3 text-base border-2 border-white/60 text-white hover:bg-white/10 transition-colors" %>
      </div>
    </div>
  </div>
</div>

<!-- Section Divider -->
<div class="flex justify-center -mt-[18px] mb-0 relative z-10">
  <div class="w-9 h-9 rounded-full bg-cs-gold flex items-center justify-center shadow-md border-2 border-cs-dark-red/20">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-cs-dark-red">
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
    </svg>
  </div>
</div>

<!-- COMMUNITY SECTION -->
<script>window.activityStream = <%= raw @activity_stream.to_json %>;</script>
<div class="container mx-auto px-4 py-12">
  <div class="max-w-5xl mx-auto">
    <div class="mb-8">
      <h2 class="text-3xl font-bold font-serif text-cs-dark-red mb-1">Community</h2>
      <p class="text-gray-500 text-sm">Was ist gerade los bei CocktailScout?</p>
    </div>
    <activity-stream compact></activity-stream>
    <div class="mt-4 text-center">
      <%= link_to "Alle Aktivitäten anzeigen →", community_path, class: "link text-sm" %>
    </div>
  </div>
</div>

<% if @news_threads.any? %>
  <!-- Section Divider -->
  <div class="flex justify-center -mb-[18px] relative z-10">
    <div class="w-9 h-9 rounded-full bg-cs-gold flex items-center justify-center shadow-md border-2 border-stone-100">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-cs-dark-red">
        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
      </svg>
    </div>
  </div>

  <!-- NEWS — full-width dark-red band -->
  <div class="bg-cs-dark-red w-full overflow-hidden relative">
    <div class="absolute top-0 left-0 w-64 h-64 rounded-full bg-white/5 -translate-y-1/2 -translate-x-1/4 pointer-events-none"></div>
    <div class="container mx-auto px-4 py-12">
      <div class="max-w-5xl mx-auto">
      <h2 class="text-2xl font-bold font-serif text-white mb-6">Neuigkeiten</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
        <% @news_threads.each do |thread| %>
          <div class="bg-white rounded-lg shadow overflow-hidden flex flex-col hover:shadow-lg transition-shadow duration-200">
            <div class="p-5 flex flex-col flex-1">
              <div class="flex items-center gap-2 mb-3">
                <span class="text-xs font-bold text-cs-dark-red uppercase tracking-wider bg-red-50 px-2 py-0.5 rounded">
                  <%= thread.created_at.strftime("%d. %b") %>
                </span>
              </div>
              <h3 class="font-bold text-gray-900 leading-snug mb-3 flex-1">
                <%= thread.title %>
              </h3>
              <%= link_to "Weiterlesen", forum_thread_path(thread), class: "btn btn-primary btn-sm self-start mt-auto" %>
            </div>
          </div>
        <% end %>
      </div>
      </div>
    </div>
  </div>
<% end %>

<!-- Section Divider -->
<div class="flex justify-center -mt-[18px] mb-10 relative z-10">
  <div class="w-9 h-9 rounded-full bg-cs-gold flex items-center justify-center shadow-md border-2 border-stone-100">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-cs-dark-red">
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
    </svg>
  </div>
</div>

<!-- ABOUT + RECIPE HIGHLIGHT -->
<div class="container mx-auto px-4 pb-16">
  <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-6 lg:items-stretch">

    <!-- About Us (2/3) -->
    <div class="lg:col-span-2 card p-8">
      <h2 class="text-2xl font-bold font-serif text-cs-dark-red mb-4">Über CocktailScout</h2>

      <p class="text-gray-700 leading-relaxed mb-4">
        CocktailScout entstand 2003 aus einer konkreten Frustration: Die schönsten Cocktail-Bücher
        waren wertlos, wenn die halben Zutaten fehlten. Also drehten wir den Prozess um.
        „Was brauche ich für dieses Rezept?" wurde zu
        „<%= link_to "Was kann ich mit dem mixen, was ich gerade habe?", my_bar_path, class: "link-underline font-medium" %>"
      </p>

      <p class="text-gray-700 leading-relaxed mb-4">
        Heute findest du hier über 1.500
        <%= link_to "Cocktail Rezepte", recipes_path, class: "link-underline font-medium" %>,
        eine <%= link_to "Galerie", recipe_images_path, class: "link-underline font-medium" %>
        voller Inspirationen und eine wachsende
        <%= link_to "Community", community_path, class: "link-underline font-medium" %>.
        Es ist aber bis heute ein Hobby-Projekt geblieben. Daher ist die Seite kostenlos, werbefrei
        und unabhängig. Macht also mit und tragt zu dem Wissen hier bei.
      </p>

      <p class="text-gray-700 leading-relaxed">
        Wer programmieren kann: CocktailScout ist ein
        <%= link_to "Open Source", "https://github.com/pawel1892/cocktailscout4", class: "link-underline font-medium" %>-Projekt.
        Wer möchte, kann auch Code beisteuern und die Seite direkt besser machen.
      </p>
    </div>

    <!-- Recipe Highlight (1/3) -->
    <% if @featured_image && @featured_image.image.attached? %>
      <div class="card hover:shadow-lg transition-shadow duration-200 flex flex-col h-full">
        <div class="flex-1 overflow-hidden min-h-0">
          <%= image_tag @featured_image.image.variant(:large), class: "object-cover w-full h-full", alt: @featured_image.recipe.title %>
        </div>
        <div class="card-body flex-shrink-0">
          <p class="text-xs text-gray-500 uppercase tracking-wider mb-1">Rezept-Highlight</p>
          <h3 class="font-bold text-lg mb-3 leading-tight"><%= @featured_image.recipe.title %></h3>
          <%= link_to "Zum Rezept", recipe_path(@featured_image.recipe.slug), class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    <% end %>

  </div>
</div>
