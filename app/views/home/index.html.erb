<% content_for :head do %>
  <%= website_structured_data %>
<% end %>
<% content_for :full_bleed_page, true %>

<!-- ============================================================
     HERO — oxblood gradient, Fraunces display, side-by-side
     ============================================================ -->
<div class="w-full flex flex-col lg:flex-row bg-cs-red-900">
  <!-- Photo -->
  <div class="w-full lg:w-1/2 overflow-hidden">
    <picture>
      <source media="(min-width: 1920px)" srcset="/images/startpage/hero1-3840.jpg">
      <source media="(min-width: 1024px)" srcset="/images/startpage/hero1-1920.jpg">
      <source media="(min-width: 640px)"  srcset="/images/startpage/hero1-1024.jpg">
      <img src="/images/startpage/hero1-640.jpg" alt="Cocktail Rezepte" class="w-full block" fetchpriority="high">
    </picture>
  </div>

  <!-- Content -->
  <div class="w-full lg:w-1/2 flex items-center justify-center px-8 py-10 md:px-10 md:py-8 xl:px-16 xl:py-12">
    <div class="w-full max-w-xl text-center md:text-left">
      <h1 class="hero-h1 tracking-tight text-cs-gold-400 mb-5">
        Cocktail Rezepte &amp; deine persönliche Bar
      </h1>
      <p class="text-lg leading-relaxed text-white/80 mb-8 max-w-md">
        1.500+ Cocktail Rezepte — und mit <strong class="text-white">Meine Bar</strong>
        siehst du sofort, was du mit deinen Zutaten mixen kannst.
      </p>
      <div class="flex flex-wrap gap-3 justify-center md:justify-start">
        <%= link_to "Rezepte entdecken", recipes_path, class: "btn btn-gold btn-lg" %>
        <%= link_to "Meine Bar", my_bar_path, class: "btn btn-outline-gold btn-lg" %>
      </div>
    </div>
  </div>
</div>

<!-- Stats band — dark card row -->
<div class="bg-cs-red-950 border-t border-cs-red-800">
  <div class="container mx-auto px-4">
    <div class="max-w-5xl mx-auto grid grid-cols-3 divide-x divide-cs-red-800 py-5">
      <div class="flex flex-col items-center gap-0.5 px-4">
        <span class="font-display font-bold text-2xl text-cs-gold-400">1.500+</span>
        <span class="text-[11px] font-mono uppercase tracking-widest text-cs-gold-700">Rezepte</span>
      </div>
      <div class="flex flex-col items-center gap-0.5 px-4">
        <span class="font-display font-bold text-2xl text-cs-gold-400">2003</span>
        <span class="text-[11px] font-mono uppercase tracking-widest text-cs-gold-700">Seit</span>
      </div>
      <div class="flex flex-col items-center gap-0.5 px-4">
        <span class="text-cs-gold-400 text-2xl"><i class="fa-solid fa-circle-check"></i></span>
        <span class="text-[11px] font-mono uppercase tracking-widest text-cs-gold-700">Kostenlos &amp; werbefrei</span>
      </div>
    </div>
  </div>
</div>

<!-- Section Divider -->
<div class="flex justify-center -mt-[18px] mb-0 relative z-10">
  <div class="w-9 h-9 rounded-full bg-cs-gold-500 flex items-center justify-center shadow-md border-2 border-cs-ink-100">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-cs-red-900">
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
    </svg>
  </div>
</div>

<!-- ============================================================
     TOP REZEPTE
     ============================================================ -->
<% if @top_recipes.any? %>
<div class="container mx-auto px-4 pt-12 pb-10">
  <div class="max-w-5xl mx-auto">
    <div class="mb-6 flex items-baseline justify-between gap-4">
      <div>
        <h2 class="font-display font-bold text-3xl text-cs-red-900 mb-1">Top Rezepte</h2>
        <p class="text-cs-ink-500 text-sm">Die am besten bewerteten Cocktails der Community</p>
      </div>
      <%= link_to "Alle Rezepte →", recipes_path(sort: "rating"), class: "btn btn-ghost btn-sm shrink-0" %>
    </div>
    <div class="flex flex-col gap-3">
      <% @top_recipes.each do |recipe| %>
        <div class="cocktail-card hover:shadow-md transition-shadow duration-200">
          <div class="w-full aspect-square rounded-lg overflow-hidden bg-cs-ink-100 flex items-center justify-center text-cs-ink-400 text-2xl">
            <%= recipe_thumbnail(recipe, size_class: "w-full h-full") %>
          </div>
          <div class="min-w-0">
            <h4><%= link_to recipe.title, recipe_path(recipe.slug) %></h4>
            <div class="author">von <strong class="text-cs-ink-800"><%= recipe.user.username %></strong></div>
            <div class="tags">
              <% recipe.tags.first(4).each do |tag| %>
                <span class="tag tag-primary-soft"><%= tag.name %></span>
              <% end %>
              <% if recipe.alcohol_content.present? && recipe.alcohol_content > 0 %>
                <span class="tag-mini"><%= number_with_precision(recipe.alcohol_content, precision: 1) %>% ABV</span>
              <% end %>
            </div>
            <div class="stats">
              <%= number_with_delimiter(recipe.visits_count) %> Aufrufe
              &nbsp;•&nbsp;
              ♥ <%= recipe.favorites_count %>
            </div>
          </div>
          <% rating = recipe.average_rating.to_f %>
          <div class="rating-chip <%= rating >= 8.0 ? 'rating-chip-high' : rating >= 6.5 ? 'rating-chip-mid' : 'rating-chip-low' %>">
            <%= number_with_precision(rating, precision: 1, separator: ",") %>
            <small class="block text-[10px] font-mono opacity-80 mt-0.5">(<%= recipe.ratings_count %>)</small>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<!-- Section Divider -->
<div class="flex justify-center mb-0 relative z-10">
  <div class="w-9 h-9 rounded-full bg-cs-gold-500 flex items-center justify-center shadow-md border-2 border-cs-ink-100">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-cs-red-900">
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
    </svg>
  </div>
</div>
<% end %>

<!-- ============================================================
     COMMUNITY
     ============================================================ -->
<script>window.activityStream = <%= raw @activity_stream.to_json %>;</script>
<div class="container mx-auto px-4 py-12">
  <div class="max-w-5xl mx-auto">
    <div class="mb-8">
      <h2 class="font-display font-bold text-3xl text-cs-red-900 mb-1">Community</h2>
      <p class="text-cs-ink-500 text-sm">Was ist gerade los bei CocktailScout?</p>
    </div>
    <activity-stream compact></activity-stream>
    <div class="mt-4 text-center">
      <%= link_to "Alle Aktivitäten anzeigen →", community_path, class: "link text-sm" %>
    </div>
  </div>
</div>

<% if @news_threads.any? %>
  <!-- Section Divider -->
  <div class="flex justify-center -mb-[18px] relative z-10">
    <div class="w-9 h-9 rounded-full bg-cs-gold-500 flex items-center justify-center shadow-md border-2 border-cs-ink-100">
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-cs-red-900">
        <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
      </svg>
    </div>
  </div>

  <!-- ============================================================
       NEWS — full-width dark-red band
       ============================================================ -->
  <div class="bg-cs-red-900 w-full overflow-hidden relative">
    <div class="absolute top-0 left-0 w-64 h-64 rounded-full bg-white/5 -translate-y-1/2 -translate-x-1/4 pointer-events-none"></div>
    <div class="container mx-auto px-4 py-12">
      <div class="max-w-5xl mx-auto">
        <h2 class="font-display font-bold text-2xl text-white mb-6">Neuigkeiten</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          <% @news_threads.each do |thread| %>
            <div class="card card-elevated flex flex-col hover:shadow-lg transition-shadow duration-200">
              <div class="card-body flex flex-col flex-1 gap-3">
                <div>
                  <span class="tag tag-gold-soft">
                    <i class="fa-regular fa-calendar text-[10px]"></i>
                    <%= thread.created_at.strftime("%d. %b") %>
                  </span>
                </div>
                <h3 class="font-semibold text-cs-ink-900 leading-snug flex-1">
                  <%= thread.title %>
                </h3>
                <%= link_to "Weiterlesen", forum_thread_path(thread), class: "btn btn-primary btn-sm self-start mt-auto" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
<% end %>

<!-- Section Divider -->
<div class="flex justify-center -mt-[18px] mb-10 relative z-10">
  <div class="w-9 h-9 rounded-full bg-cs-gold-500 flex items-center justify-center shadow-md border-2 border-cs-ink-100">
    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 text-cs-red-900">
      <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
    </svg>
  </div>
</div>

<!-- ============================================================
     ABOUT + RECIPE HIGHLIGHT
     ============================================================ -->

<div class="container mx-auto px-4 pb-16">
  <div class="max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-6 lg:items-stretch">

    <!-- About (2/3) -->
    <div class="lg:col-span-2 card">
      <div class="card-header">
        <span class="font-display font-bold text-xl text-cs-red-900">Über CocktailScout</span>
      </div>
      <div class="card-body space-y-4 text-[15px] leading-relaxed">
        <p class="text-cs-ink-700">
          CocktailScout entstand 2003 aus einer konkreten Frustration: Die schönsten Cocktail-Bücher
          waren wertlos, wenn die halben Zutaten fehlten. Also drehten wir den Prozess um.
          „Was brauche ich für dieses Rezept?" wurde zu
          „<%= link_to "Was kann ich mit dem mixen, was ich gerade habe?", my_bar_path, class: "link-underline font-medium" %>"
        </p>
        <p class="text-cs-ink-700">
          Heute findest du hier über 1.500
          <%= link_to "Cocktail Rezepte", recipes_path, class: "link-underline font-medium" %>,
          eine <%= link_to "Galerie", recipe_images_path, class: "link-underline font-medium" %>
          voller Inspirationen und eine wachsende
          <%= link_to "Community", community_path, class: "link-underline font-medium" %>.
          Es ist aber bis heute ein Hobby-Projekt geblieben. Daher ist die Seite kostenlos, werbefrei
          und unabhängig. Macht also mit und tragt zu dem Wissen hier bei.
        </p>
        <p class="text-cs-ink-700">
          Wer programmieren kann: CocktailScout ist ein
          <%= link_to "Open Source", "https://github.com/pawel1892/cocktailscout4", class: "link-underline font-medium" %>-Projekt.
          Wer möchte, kann auch Code beisteuern und die Seite direkt besser machen.
        </p>
      </div>
      <div class="card-footer flex gap-3">
        <%= link_to "Rezepte entdecken", recipes_path, class: "btn btn-primary btn-sm" %>
        <%= link_to "Community", community_path, class: "btn btn-ghost btn-sm" %>
      </div>
    </div>

    <!-- Recipe Highlight (1/3) -->
    <% if @featured_image && @featured_image.image.attached? %>
      <div class="card hover:shadow-lg transition-shadow duration-200 flex flex-col h-full">
        <div class="flex-1 overflow-hidden min-h-0">
          <%= image_tag @featured_image.image.variant(:large),
                class: "object-cover w-full h-full",
                alt: @featured_image.recipe.title %>
        </div>
        <div class="card-body flex-shrink-0">
          <p class="text-xs text-cs-ink-500 uppercase tracking-wider mb-1 font-mono">Rezept-Highlight</p>
          <h3 class="font-semibold text-lg mb-3 leading-tight text-cs-ink-900">
            <%= @featured_image.recipe.title %>
          </h3>
          <%= link_to "Zum Rezept", recipe_path(@featured_image.recipe.slug), class: "btn btn-primary btn-sm" %>
        </div>
      </div>
    <% end %>

  </div>
</div>

<!-- ============================================================
     MEINE BAR — Feature Promo
     ============================================================ -->
<div class="bg-cs-red-900 w-full overflow-hidden relative">
  <div class="absolute top-0 right-0 w-80 h-80 rounded-full bg-white/5 translate-x-1/3 -translate-y-1/3 pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-48 h-48 rounded-full bg-cs-gold-900/30 -translate-x-1/4 translate-y-1/3 pointer-events-none"></div>
  <div class="container mx-auto px-4 py-14 relative z-10">
    <div class="max-w-5xl mx-auto flex flex-col lg:flex-row items-center gap-10">

      <!-- Icon visual -->
      <div class="flex-shrink-0 w-28 h-28 rounded-2xl bg-cs-red-800 border border-cs-red-700 flex items-center justify-center text-cs-gold-400">
        <i class="fa-solid fa-wine-bottle text-5xl"></i>
      </div>

      <!-- Content -->
      <div class="flex-1 text-center lg:text-left">
        <span class="tag tag-gold-soft mb-4 inline-block">Meine Bar</span>
        <h2 class="font-display font-bold text-3xl text-white mb-3 leading-tight">
          Was kannst du heute mixen?
        </h2>
        <p class="text-white/80 text-[15px] leading-relaxed mb-6 max-w-lg">
          Trage ein, welche Zutaten du zu Hause hast — CocktailScout zeigt dir sofort alle
          Rezepte, die du damit zubereiten kannst. Kein Blättern mehr, kein Raten.
        </p>
        <div class="flex flex-wrap gap-3 justify-center lg:justify-start">
          <%= link_to "Meine Bar öffnen", my_bar_path, class: "btn btn-gold btn-lg" %>
          <%= link_to "Alle Rezepte", recipes_path, class: "btn btn-outline-gold btn-lg" %>
        </div>
      </div>

      <!-- Stats cluster -->
      <div class="flex-shrink-0 flex flex-col gap-4">
        <div class="card card-elevated text-center px-6 py-4 min-w-[120px]">
          <div class="font-display font-bold text-3xl text-cs-red-900">1.500+</div>
          <div class="text-[11px] font-mono uppercase tracking-widest text-cs-ink-500 mt-1">Rezepte</div>
        </div>
        <div class="card card-elevated text-center px-6 py-4 min-w-[120px]">
          <div class="text-3xl text-cs-red-900"><i class="fa-solid fa-circle-check"></i></div>
          <div class="text-[11px] font-mono uppercase tracking-widest text-cs-ink-500 mt-1">Kostenlos &amp; werbefrei</div>
        </div>
      </div>

    </div>
  </div>
</div>
