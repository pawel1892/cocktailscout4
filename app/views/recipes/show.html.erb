<% content_for :head do %>
  <%= recipe_structured_data(@recipe) %>
  <%= breadcrumb_structured_data(@recipe) %>
<% end %>

<!-- Draft Indicator -->
<% if @recipe.draft? %>
  <div class="callout callout-gold mb-4">
    <i class="fas fa-file-alt"></i>
    <strong>Entwurf:</strong> Dieses Rezept ist noch nicht veröffentlicht und nur für dich sichtbar.
  </div>
<% end %>

<!-- Title -->
<div class="mb-5 flex items-start justify-between gap-4">
  <div class="min-w-0 flex-1">
    <h1 class="font-display font-semibold text-[38px] sm:text-[54px] leading-none tracking-tight text-cs-red-900 mb-3 break-words"><%= @recipe.title %></h1>
    <div class="w-10 h-0.5 bg-cs-gold-400 mb-3"></div>
    <%= render "recipes/tag_list", tags: @recipe.tags %>
  </div>
  <div class="flex-shrink-0 pt-2">
    <favorite-toggle
      favoritable-type="Recipe"
      :favoritable-id="<%= @recipe.id %>"
      :initial-favorited="<%= (Current.user && Current.user.favorites.exists?(favoritable: @recipe)) ? 'true' : 'false' %>"
    ></favorite-toggle>
  </div>
</div>

<!-- Metadata strip -->
<div class="flex flex-wrap items-start sm:items-center justify-between gap-x-6 gap-y-3 border-y border-cs-ink-100 py-4 mb-8">
  <!-- Left: Rating -->
  <div>
    <rating-control
      rateable-type="Recipe"
      :rateable-id="<%= @recipe.id %>"
      :initial-average="<%= @recipe.average_rating || 0 %>"
      :initial-count="<%= @recipe.ratings_count || 0 %>"
      :min-ratings="<%= Rateable::MIN_RATINGS_FOR_DISPLAY %>"
      :user-rating="<%= (Current.user && @recipe.ratings.find_by(user: Current.user)&.score) || 'null' %>"
    ></rating-control>
    <% if @recipe.has_ratings? %>
      <%= link_to bewertungen_recipe_path(@recipe), class: "text-xs text-cs-red-900 hover:underline mt-1 inline-flex items-center gap-1" do %>
        <i class="fas fa-chart-bar"></i> Alle Bewertungen ansehen
      <% end %>
    <% end %>
  </div>

  <!-- Right: Author + Stats -->
  <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
    <span class="text-sm text-cs-ink-600 flex items-center gap-1">
      <span class="text-cs-ink-400">von</span>
      <%= user_badge(@recipe.user) %>
    </span>
    <span class="font-mono text-xs text-cs-ink-400 flex items-center gap-1">
      <i class="far fa-eye"></i> <%= number_with_delimiter(@recipe.visits_count) %>
    </span>
    <span class="font-mono text-xs text-cs-ink-400 flex items-center gap-1">
      <i class="far fa-heart"></i> <%= number_with_delimiter(@recipe.favorites_count) %>
    </span>
  </div>
</div>

<!-- Image & Ingredients Section -->
<% show_image_col = @recipe.approved_recipe_images.any? || Current.user %>
<div class="mb-8 grid grid-cols-1 md:grid-cols-3 gap-6">
  <!-- Image column -->
  <% if show_image_col %>
    <div class="md:col-span-1 md:order-2">
      <% if @recipe.approved_recipe_images.any? %>
        <recipe-image-gallery></recipe-image-gallery>
        <% if Current.user %>
          <div class="mt-2 text-center">
            <%= link_to bilder_recipe_path(@recipe), class: "btn btn-outline btn-sm" do %>
              <i class="fas fa-camera mr-1"></i> Bild hochladen
            <% end %>
          </div>
        <% end %>
      <% else %>
        <div class="card h-full flex flex-col items-center justify-center py-10 px-4 text-center">
          <i class="fas fa-camera text-4xl text-cs-ink-300 mb-3"></i>
          <p class="text-cs-ink-500 text-sm mb-4">Noch keine Fotos vorhanden</p>
          <%= link_to bilder_recipe_path(@recipe), class: "btn btn-outline btn-sm" do %>
            <i class="fas fa-camera mr-1"></i> Bild hochladen
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Ingredients (2 columns on md+ when image col present, full width otherwise) -->
  <div class="<%= show_image_col ? 'md:col-span-2 md:order-1' : 'md:col-span-3' %>">
    <recipe-scaling
      recipe-slug="<%= @recipe.slug %>"
      :scalable="<%= @recipe.has_scalable_ingredients? %>"
      :initial-ingredients='<%= h @recipe.recipe_ingredients.map { |ri|
        wiki = @wiki_articles_by_ingredient_id[ri.ingredient_id]&.first
        {
          id: ri.id,
          amount: ri.amount,
          unit_name: ri.unit&.name,
          unit_display_name: ri.unit&.display_name,
          ingredient_name: ri.formatted_ingredient_name,
          ingredient_plural_name: ri.ingredient.plural_name,
          formatted_amount: ri.formatted_amount,
          additional_info: ri.additional_info,
          is_scalable: ri.is_scalable,
          is_optional: ri.is_optional,
          needs_review: ri.needs_review,
          old_description: ri.old_description,
          # TEMP_WIKI_PROD_HIDE: Hide ingredient wiki links in production for non-editors.
          wiki_article_slug: wiki_visible? ? wiki&.slug : nil,
          wiki_article_title: wiki_visible? ? wiki&.title : nil
        }
      }.to_json %>'
      :initial-alcohol-info='<%= h({
        total_volume_ml: @recipe.total_volume_in_ml.round(1),
        alcohol_volume_ml: @recipe.alcohol_volume_in_ml.round(1),
        alcohol_content_percent: @recipe.calculate_alcohol_content
      }.to_json) %>'
    ></recipe-scaling>
  </div>
</div>

<% if @recipe.approved_recipe_images.any? %>
  <% content_for :head do %>
    <script>
      window.recipeImages = <%= raw @recipe.approved_recipe_images.sort_by { |img| img.high_quality ? 0 : 1 }.map { |image|
        {
          id: image.id,
          mediumUrl: url_for(recipe_image_url(image, style: :medium)),
          largeUrl: url_for(recipe_image_url(image, style: :large)),
          recipeTitle: @recipe.title,
          recipeUrl: recipe_path(@recipe),
          user: image.user && { id: image.user.id, username: image.user.username, rank: image.user.rank, avatar_url_small: image.user.avatar_path(:small) },
          uploadDate: l(image.created_at.to_date)
        }
      }.to_json %>;
    </script>
  <% end %>
<% end %>

<!-- Preparation / Description -->
<% if @recipe.description.present? %>
  <div class="mb-8">
    <h2 class="font-display font-semibold text-[28px] leading-tight text-cs-red-900 mb-1">Zubereitung</h2>
    <div class="w-8 h-0.5 bg-cs-gold-400 mb-5"></div>
    <div class="prose prose-cs max-w-none">
      <%= render_markdown(@recipe.description) %>
    </div>
  </div>
<% end %>

<!-- Comments -->
<% content_for :head do %>
  <script>
    window.recipeComments = <%= raw @comments_json %>;
    window.recipeCommentsMeta = { isModerator: <%= Current.user&.can_moderate_recipe? ? 'true' : 'false' %> };
  </script>
<% end %>
<recipe-comments recipe-slug="<%= @recipe.slug %>"></recipe-comments>
