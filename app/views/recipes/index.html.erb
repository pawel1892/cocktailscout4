<% content_for :head do %>
  <%= pagy_seo_tags(@pagy) %>
<% end %>

<!-- Page Header -->
<div class="mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-3">
  <div>
    <h1 class="font-display font-bold text-3xl text-cs-red-900 tracking-tight">Rezepte</h1>
    <p class="text-sm text-cs-ink-500 mt-0.5">
      <%= @pagy.count %> <%= Recipe.model_name.human(count: @pagy.count) %> gefunden
    </p>
  </div>
</div>

<!-- Active Filters -->
<% if active_filters.any? %>
  <div class="mb-4 p-3 bg-cs-link-50 border border-cs-link-100 rounded-lg flex flex-wrap items-center gap-2">
    <span class="text-xs font-semibold text-cs-link-700 uppercase tracking-wider mr-1">Filter aktiv:</span>
    <% active_filters.each do |filter| %>
      <%= link_to recipes_path(params.permit(:sort, :direction, :q, :min_rating, :tag, :ingredient_id, :user_id, :collection_id, :filter).except(filter[:param])),
            class: "tag tag-info gap-1.5" do %>
        <%= filter[:label] %>
        <i class="fas fa-times text-[9px]"></i>
      <% end %>
    <% end %>
    <%= link_to "Alle zurücksetzen", recipes_path(params.permit(:sort, :direction)),
          class: "ml-auto text-xs text-cs-link-700 hover:text-cs-link-900 underline" %>
  </div>
<% end %>

<!-- Filter Bar -->
<div class="mb-5 bg-white rounded-lg shadow-xs border border-cs-ink-200 p-4">
  <%= form_with url: recipes_path, method: :get, class: "space-y-3", data: { turbo_frame: "_top" } do |f| %>
    <%= f.hidden_field :sort, value: params[:sort] if params[:sort] %>
    <%= f.hidden_field :direction, value: params[:direction] if params[:direction] %>

    <!-- Row 1: search fields -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3">
      <div class="col-span-2 md:col-span-1 lg:col-span-2 flex flex-col gap-1">
        <%= f.label :q, "Suche", class: "label-field mb-0" %>
        <div class="relative">
          <%= f.text_field :q, value: params[:q], placeholder: "Rezeptname...",
                class: "input-field py-1.5 text-sm pl-8" %>
          <i class="fas fa-search absolute left-2.5 top-1/2 -translate-y-1/2 text-cs-ink-400 text-xs"></i>
        </div>
      </div>

      <div class="flex flex-col gap-1">
        <%= f.label :min_rating, "Bewertung", class: "label-field mb-0" %>
        <%= f.select :min_rating,
            options_for_select([["Alle", ""], ["5+", 5], ["6+", 6], ["7+", 7], ["8+", 8], ["9+", 9]], params[:min_rating]),
            {}, class: "input-field py-1.5 text-sm" %>
      </div>

      <div class="flex flex-col gap-1">
        <%= f.label :tag, "Kategorie", class: "label-field mb-0" %>
        <%= f.collection_select :tag, @tags, :name, :name,
            { include_blank: "Alle" },
            { class: "input-field py-1.5 text-sm", value: params[:tag] } %>
      </div>

      <div class="flex flex-col gap-1">
        <%= f.label :ingredient_id, "Zutat", class: "label-field mb-0" %>
        <%= f.collection_select :ingredient_id, @ingredients, :id, :name,
            { include_blank: "Alle" },
            { class: "input-field py-1.5 text-sm", value: params[:ingredient_id] } %>
      </div>

      <div class="flex flex-col gap-1">
        <label class="label-field mb-0">Benutzer</label>
        <user-autocomplete
          initial-username="<%= @filter_user&.username %>"
          initial-user-id="<%= params[:user_id] %>"
        ></user-autocomplete>
      </div>
    </div>

    <!-- Row 2: list filter + actions -->
    <div class="flex flex-wrap items-center gap-3">
      <% if @collections.any? %>
        <div class="flex flex-col gap-1 min-w-[180px]">
          <%= f.label :collection_id, "Meine Liste", class: "label-field mb-0" %>
          <%= f.collection_select :collection_id, @collections, :id, :name,
              { include_blank: "Alle Rezepte" },
              { class: "input-field py-1.5 text-sm", value: params[:collection_id] } %>
        </div>
      <% end %>

      <% if Current.user %>
        <label class="inline-flex items-center gap-2 cursor-pointer py-1.5 px-3 bg-white border border-cs-ink-300 rounded-md hover:bg-cs-ink-50 transition-colors h-[34px] mt-auto">
          <%= f.check_box :filter, { checked: params[:filter] == "favorites", onchange: "this.form.submit()", class: "hidden" }, "favorites", "" %>
          <i class="<%= params[:filter] == 'favorites' ? 'fas text-cs-error-500' : 'far text-cs-ink-400' %> fa-heart"></i>
          <span class="<%= params[:filter] == 'favorites' ? 'font-medium text-cs-ink-900' : 'text-cs-ink-600' %> text-sm select-none">Nur Favoriten</span>
        </label>
      <% end %>

      <div class="ml-auto mt-auto">
        <%= f.submit "Filtern", class: "btn btn-primary btn-sm h-[34px]" %>
      </div>
    </div>
  <% end %>
</div>

<!-- Sort Bar -->
<div class="mb-5 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-cs-ink-600 bg-cs-ink-50 px-4 py-2.5 rounded-lg border border-cs-ink-200">
  <span class="font-semibold text-cs-ink-500 text-xs uppercase tracking-wider">Sortieren:</span>
  <%= sortable "title", Recipe.human_attribute_name(:title) %>
  <%= sortable "average_rating", Recipe.human_attribute_name(:average_rating), default_dir: "desc" %>
  <%= sortable "users.username", Recipe.human_attribute_name(:user) %>
  <%= sortable "alcohol_content", Recipe.human_attribute_name(:alcohol_content) %>
  <%= sortable "visits_count", Recipe.human_attribute_name(:visits_count), default_dir: "desc" %>
  <%= sortable "favorites_count", Recipe.human_attribute_name(:favorites_count), default_dir: "desc" %>
  <%= sortable "created_at", "Neueste", default_dir: "desc" %>
</div>

<% if @pagy.pages > 1 %>
  <div class="flex justify-center mb-5">
    <%== @pagy.series_nav %>
  </div>
<% end %>

<!-- Recipe List -->
<div class="space-y-3">
  <% if @recipes.any? %>
    <% @recipes.each do |recipe| %>
      <div class="bg-white border border-cs-ink-200 rounded-xl shadow-xs hover:shadow-md transition-all duration-200 group">
        <div class="flex gap-4 p-4">
          <!-- Thumbnail -->
          <div class="flex-shrink-0">
            <%= link_to recipe_path(recipe) do %>
              <%= recipe_thumbnail(recipe, size_class: "w-20 h-20 sm:w-24 sm:h-24 rounded-lg") %>
            <% end %>
          </div>

          <!-- Content -->
          <div class="flex-1 min-w-0">
            <div class="flex justify-between items-start gap-3">
              <div class="min-w-0 flex-1">
                <!-- Title + Favorite -->
                <div class="flex items-center gap-2 mb-1">
                  <%= link_to recipe.title, recipe_path(recipe),
                        class: "font-bold text-lg leading-tight text-cs-link-500 hover:text-cs-red-900 transition-colors truncate" %>
                  <favorite-toggle
                    favoritable-type="Recipe"
                    :favoritable-id="<%= recipe.id %>"
                    :initial-favorited="<%= @favorite_recipe_ids.include?(recipe.id) ? 'true' : 'false' %>"
                    size="text-lg"
                  ></favorite-toggle>
                </div>
                <!-- Author -->
                <div class="text-xs text-cs-ink-500 mb-2 flex flex-wrap items-center gap-1">
                  <span>von</span>
                  <%= user_badge(recipe.user) %>
                </div>
              </div>

              <!-- Rating chip -->
              <div class="flex flex-col items-center gap-1 flex-shrink-0">
                <% if recipe.show_rating? %>
                  <div class="<%= rating_badge_class(recipe.average_rating) %> px-2 py-1 md:px-3 md:py-2 rounded-lg text-sm md:text-lg font-bold font-display whitespace-nowrap min-w-[3rem] md:min-w-[3.5rem] text-center text-white">
                    <%= number_with_precision(recipe.average_rating, precision: 1, separator: ",") %>
                  </div>
                  <span class="text-[10px] text-cs-ink-400 font-mono">(<%= recipe.ratings_count %>)</span>
                <% else %>
                  <div class="bg-cs-ink-300 px-2 py-1 md:px-3 md:py-2 rounded-lg text-sm md:text-lg font-bold whitespace-nowrap min-w-[3rem] md:min-w-[3.5rem] text-center text-white">–</div>
                  <span class="text-[10px] text-cs-ink-400 font-mono">(<%= recipe.ratings_count %>/4)</span>
                <% end %>
              </div>
            </div>

            <!-- Tags -->
            <% if recipe.tag_list.any? %>
              <div class="mb-2">
                <%= render "recipes/tag_list", tags: recipe.tags %>
              </div>
            <% end %>

            <!-- Stats -->
            <div class="flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-cs-ink-400 font-mono">
              <% if recipe.alcohol_content.present? %>
                <span class="flex items-center gap-1" title="<%= Recipe.human_attribute_name(:alcohol_content) %>">
                  <i class="fas fa-wine-glass-alt"></i>
                  <%= number_to_percentage recipe.alcohol_content, precision: 1 %>
                </span>
              <% end %>
              <span class="flex items-center gap-1" title="<%= Recipe.human_attribute_name(:visits_count) %>">
                <i class="far fa-eye"></i>
                <%= number_with_delimiter recipe.visits_count %>
              </span>
              <span class="flex items-center gap-1" title="<%= Recipe.human_attribute_name(:favorites_count) %>">
                <i class="far fa-heart"></i>
                <%= number_with_delimiter recipe.favorites_count %>
              </span>
            </div>
          </div>
        </div>
      </div>
    <% end %>

  <% else %>
    <!-- Empty state -->
    <div class="card card-ghost p-12 text-center">
      <div class="text-cs-ink-300 mb-4">
        <i class="fas fa-search text-5xl"></i>
      </div>
      <h3 class="font-display font-bold text-xl text-cs-ink-800 mb-2">Keine Rezepte gefunden</h3>
      <p class="text-cs-ink-500 mb-8 max-w-md mx-auto">Leider konnten wir keine Rezepte finden, die deinen Filtereinstellungen entsprechen. Versuche es mit weniger Filtern oder anderen Kriterien.</p>
      <%= link_to "Alle Filter zurücksetzen", recipes_path(params.permit(:sort, :direction)), class: "btn btn-primary" %>
    </div>
  <% end %>
</div>

<% if @pagy.pages > 1 %>
  <div class="flex justify-center py-8">
    <%== @pagy.series_nav %>
  </div>
<% end %>
