<div class="max-w-4xl mx-auto">
  <div class="mb-6">
    <%= link_to admin_recipe_images_path, class: "link flex items-center gap-1 text-sm mb-4" do %>
      <i class="fas fa-chevron-left"></i>
      Zurück zur Übersicht
    <% end %>

    <div class="flex flex-col lg:flex-row justify-between items-start lg:items-center gap-4">
      <div>
        <h1 class="text-3xl font-bold text-cs-ink-900 mb-2">Bild von <%= @recipe_image.user.username %></h1>
        <div class="flex items-center gap-3 text-sm text-cs-ink-600">
          <span>Rezept: <strong><%= @recipe_image.recipe.title %></strong></span>
          <span>•</span>
          <span>Hochgeladen <%= l(@recipe_image.created_at, format: :short) %></span>
        </div>
      </div>
      <%= render "shared/recipe_image_state_badge", recipe_image: @recipe_image %>
    </div>
  </div>

  <!-- Image Preview -->
  <div class="card p-6 mb-6">
    <h2 class="text-lg font-semibold text-cs-ink-900 mb-4">Bild</h2>
    <% if @recipe_image.image.attached? %>
      <%= image_tag @recipe_image.image.variant(:large), class: "max-w-full rounded-lg shadow", alt: "Bild" %>
      <% if !@recipe_image.soft_deleted? %>
        <div class="flex gap-2 mt-4">
          <%= button_to rotate_left_admin_recipe_image_path(@recipe_image), method: :post,
                class: "btn btn-outline btn-sm",
                title: "90° nach links drehen" do %>
            <i class="fa-solid fa-rotate-left"></i> Links drehen
          <% end %>
          <%= button_to rotate_right_admin_recipe_image_path(@recipe_image), method: :post,
                class: "btn btn-outline btn-sm",
                title: "90° nach rechts drehen" do %>
            <i class="fa-solid fa-rotate-right"></i> Rechts drehen
          <% end %>
        </div>
      <% end %>
    <% else %>
      <div class="bg-cs-ink-100 rounded-lg p-12 text-center text-cs-ink-500">
        <i class="fa-solid fa-image text-4xl mb-2"></i>
        <p>Kein Bild verfügbar</p>
      </div>
    <% end %>
  </div>

  <!-- Actions for Pending Images -->
  <% if @recipe_image.pending? %>
    <div class="bg-cs-blue-50 border border-cs-blue-100 rounded-lg p-6 mb-6">
      <h3 class="font-semibold text-cs-blue-900 mb-4 flex items-center gap-2">
        <i class="fa-solid fa-gavel"></i>
        Bild prüfen
      </h3>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <!-- Approve -->
        <div class="bg-white rounded-lg border border-cs-success-50 p-4">
          <h4 class="font-semibold text-cs-success-700 mb-2 flex items-center gap-2">
            <i class="fa-solid fa-check-circle"></i>
            Genehmigen
          </h4>
          <p class="text-sm text-cs-ink-700 mb-4">
            Das Bild wird in der Cocktailgalerie veröffentlicht.
          </p>
          <%= button_to "Bild genehmigen",
            approve_admin_recipe_image_path(@recipe_image),
            method: :post,
            class: "btn btn-primary w-full",
            data: { confirm: "Dieses Bild genehmigen und veröffentlichen?" } %>
        </div>

        <!-- Reject -->
        <div class="bg-white rounded-lg border border-red-200 p-4">
          <h4 class="font-semibold text-red-900 mb-2 flex items-center gap-2">
            <i class="fa-solid fa-times-circle"></i>
            Ablehnen
          </h4>
          <%= form_with url: reject_admin_recipe_image_path(@recipe_image), method: :post, class: "space-y-3" do |f| %>
            <%= f.label :moderation_reason, "Ablehnungsgrund (optional):", class: "label-field text-sm" %>
            <%= f.text_area :moderation_reason,
              rows: 3,
              placeholder: "Begründe kurz, warum dieses Bild abgelehnt wird...",
              class: "input-field text-sm" %>
            <%= f.submit "Bild ablehnen",
              class: "btn btn-outline-danger w-full",
              data: { confirm: "Dieses Bild ablehnen?" } %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>

  <!-- Moderation Information (for moderated images) -->
  <% if @recipe_image.moderated_at %>
    <div class="card p-6 mb-6">
      <h2 class="text-lg font-semibold text-cs-ink-900 mb-4">Moderationsinformationen</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 text-sm">
        <div>
          <span class="text-cs-ink-600">Moderiert am:</span>
          <span class="font-medium"><%= l(@recipe_image.moderated_at, format: :long) %></span>
        </div>
        <div>
          <span class="text-cs-ink-600">Moderiert von:</span>
          <span class="font-medium"><%= @recipe_image.moderated_by.username %></span>
        </div>
      </div>

      <% if @recipe_image.rejected? && @recipe_image.moderation_reason.present? %>
        <div class="bg-red-50 border border-red-200 rounded-lg p-4 mt-4">
          <p class="font-semibold text-red-900 mb-1">Ablehnungsgrund:</p>
          <p class="text-red-800"><%= simple_format(@recipe_image.moderation_reason) %></p>
        </div>
      <% end %>
    </div>
  <% end %>

  <!-- Recipe Info -->
  <div class="card p-6 mb-6">
    <h2 class="text-lg font-semibold text-cs-ink-900 mb-4">Rezeptinformationen</h2>
    <div class="text-sm space-y-2">
      <div>
        <span class="text-cs-ink-600">Rezept:</span>
        <span class="font-medium"><%= @recipe_image.recipe.title %></span>
      </div>
      <div>
        <span class="text-cs-ink-600">Hochgeladen von:</span>
        <span class="font-medium"><%= @recipe_image.user.username %></span>
      </div>
    </div>
  </div>

  <!-- Featured Image -->
  <% if @recipe_image.approved? && !@recipe_image.soft_deleted? && @recipe_image.recipe.is_public? && !@recipe_image.recipe.is_deleted? && Current.user.can_moderate_image? %>
    <div class="card p-6 mb-6">
      <h2 class="text-lg font-semibold text-cs-ink-900 mb-4">Featured Bild</h2>
      <% if @recipe_image.featured? %>
        <p class="text-sm text-cs-success-700 mb-4">Dieses Bild ist aktuell das Featured Bild auf der Startseite.</p>
        <%= button_to "Featured entfernen", admin_featured_recipe_image_path(@recipe_image), method: :delete,
              class: "btn btn-outline btn-sm",
              data: { confirm: "Featured-Status entfernen?" } %>
      <% else %>
        <p class="text-sm text-cs-ink-600 mb-4">Dieses Bild auf der Startseite als Featured Bild anzeigen.</p>
        <%= button_to "Als Featured setzen", admin_featured_recipe_images_path(recipe_image_id: @recipe_image.id), method: :post,
              class: "btn btn-primary btn-sm",
              data: { confirm: "Dieses Bild als Featured Bild auf der Startseite setzen?" } %>
      <% end %>
    </div>
  <% end %>

  <!-- High Quality Flag -->
  <% if @recipe_image.approved? && !@recipe_image.soft_deleted? && Current.user.can_mark_high_quality? %>
    <div class="card p-6 mb-6">
      <h2 class="text-lg font-semibold text-cs-ink-900 mb-1">Hochwertig</h2>
      <p class="text-sm text-cs-ink-500 mb-4">Bilder mit dieser Markierung werden als Bilderpool auf der Startseite verwendet. Nur Admins und Supermods können dies setzen.</p>
      <% if @recipe_image.high_quality? %>
        <div class="flex items-center gap-3">
          <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-cs-success-50 border border-cs-success-200 text-cs-success-700 text-sm font-medium">
            <i class="fa-solid fa-star text-xs"></i> Als hochwertig markiert
          </span>
          <%= button_to "Markierung entfernen", admin_high_quality_recipe_image_path(@recipe_image), method: :delete,
                class: "btn btn-outline btn-sm",
                data: { confirm: "Hochwertig-Markierung entfernen?" } %>
        </div>
      <% else %>
        <%= button_to "Als hochwertig markieren", admin_high_quality_recipe_images_path(recipe_image_id: @recipe_image.id), method: :post,
              class: "btn btn-primary btn-sm" %>
      <% end %>
    </div>
  <% end %>

  <!-- Delete / Restore Action -->
  <% if @recipe_image.soft_deleted? %>
    <div class="bg-cs-warning-50 border border-yellow-200 rounded-lg p-6">
      <h3 class="font-semibold text-cs-warning-700 mb-2 flex items-center gap-2">
        <i class="fa-solid fa-rotate-left"></i>
        Bild wiederherstellen
      </h3>
      <p class="text-sm text-cs-ink-600 mb-4">
        Kann bis zum <%= l(@recipe_image.deleted_at + 1.month, format: :long) %> wiederhergestellt werden.
      </p>
      <%= button_to "Bild wiederherstellen",
            restore_admin_recipe_image_path(@recipe_image),
            method: :post,
            class: "btn btn-primary" %>
    </div>
  <% elsif @recipe_image.pending? %>
    <div class="border border-cs-ink-200 rounded-lg px-6 py-4 text-sm text-cs-ink-500 flex items-center gap-2">
      <i class="fa-solid fa-lock"></i>
      Bild muss zuerst genehmigt oder abgelehnt werden, bevor es gelöscht werden kann.
    </div>
  <% else %>
    <details class="group border border-cs-ink-200 rounded-lg">
      <summary class="flex items-center justify-between px-6 py-4 cursor-pointer text-sm text-cs-ink-500 hover:text-cs-ink-700 hover:bg-cs-ink-50 rounded-lg list-none">
        <span class="flex items-center gap-2">
          <i class="fa-solid fa-trash"></i>
          Bild löschen
        </span>
        <i class="fa-solid fa-chevron-down transition-transform group-open:rotate-180"></i>
      </summary>
      <div class="px-6 py-4 border-t border-cs-ink-200 bg-cs-ink-50 rounded-b-lg">
        <p class="text-sm text-cs-ink-600 mb-4">
          Das Bild wird sofort aus der öffentlichen Galerie entfernt und nach 30 Tagen endgültig gelöscht.
        </p>
        <%= button_to "Bild löschen",
              admin_recipe_image_path(@recipe_image),
              method: :delete,
              data: { confirm: "Bild wirklich löschen? Es wird nach 30 Tagen endgültig entfernt." },
              class: "btn btn-danger" %>
      </div>
    </details>
  <% end %>
</div>
