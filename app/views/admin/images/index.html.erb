<div class="mb-8 flex items-center justify-between">
  <h1 class="text-3xl font-bold text-cs-ink-800">Bilderverwaltung</h1>
</div>

<!-- Tabs -->
<div class="bg-white rounded-lg shadow border border-cs-ink-200 mb-6">
  <div class="border-b border-cs-ink-200">
    <nav class="flex -mb-px">
      <%= link_to admin_images_path(tab: "forum"),
        class: "flex items-center gap-2 px-6 py-4 text-sm font-medium border-b-2 #{(@tab == 'forum' || @tab.nil?) ? 'border-cs-red-900 text-cs-red-900' : 'border-transparent text-cs-ink-500 hover:text-cs-ink-700 hover:border-cs-ink-300'}" do %>
        <i class="fa-solid fa-comments"></i>
        Forum-Bilder
        <span class="inline-flex items-center justify-center px-2 py-0.5 text-xs font-bold bg-cs-ink-200 text-cs-ink-700 rounded-full">
          <%= ForumImage.count %>
        </span>
        <% orphan_count = ForumImage.marked_as_orphaned.count %>
        <% if orphan_count > 0 %>
          <span class="inline-flex items-center justify-center px-2 py-0.5 text-xs font-bold bg-orange-200 text-orange-800 rounded-full">
            <%= orphan_count %> verwaist
          </span>
        <% end %>
      <% end %>

      <%= link_to admin_images_path(tab: "avatar"),
        class: "flex items-center gap-2 px-6 py-4 text-sm font-medium border-b-2 #{@tab == 'avatar' ? 'border-cs-red-900 text-cs-red-900' : 'border-transparent text-cs-ink-500 hover:text-cs-ink-700 hover:border-cs-ink-300'}" do %>
        <i class="fa-solid fa-user-circle"></i>
        Avatare
        <span class="inline-flex items-center justify-center px-2 py-0.5 text-xs font-bold bg-cs-ink-200 text-cs-ink-700 rounded-full">
          <%= ActiveStorage::Attachment.where(record_type: "User", name: "avatar").count %>
        </span>
      <% end %>

      <%= link_to admin_images_path(tab: "recipe"),
        class: "flex items-center gap-2 px-6 py-4 text-sm font-medium border-b-2 border-transparent text-cs-ink-500 hover:text-cs-ink-700 hover:border-cs-ink-300" do %>
        <i class="fa-solid fa-cocktail"></i>
        Rezept-Bilder
        <i class="fa-solid fa-arrow-up-right-from-square text-xs"></i>
      <% end %>
    </nav>
  </div>
</div>

<% if @tab == "forum" || @tab.nil? %>

  <!-- Orphan filter -->
  <div class="mb-4 flex items-center gap-3">
    <% if params[:filter] == "orphan" %>
      <%= link_to admin_images_path(tab: "forum"), class: "btn btn-outline btn-sm" do %>
        <i class="fa-solid fa-times mr-1"></i> Filter aufheben
      <% end %>
      <span class="text-sm text-orange-700 font-medium">Zeige nur verwaiste Bilder</span>
    <% else %>
      <%= link_to admin_images_path(tab: "forum", filter: "orphan"), class: "btn btn-outline btn-sm" do %>
        <i class="fa-solid fa-filter mr-1"></i> Nur Waisen anzeigen
      <% end %>
    <% end %>
  </div>

  <% if @images.any? %>
    <div class="bg-white rounded-lg shadow border border-cs-ink-200 overflow-hidden">
      <table class="min-w-full divide-y divide-cs-ink-200">
        <thead class="bg-cs-ink-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-cs-ink-500 uppercase tracking-wider">Vorschau</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-cs-ink-500 uppercase tracking-wider">Hochgeladen von</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-cs-ink-500 uppercase tracking-wider">Größe</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-cs-ink-500 uppercase tracking-wider">Datum</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-cs-ink-500 uppercase tracking-wider">Status</th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-cs-ink-500 uppercase tracking-wider">Aktionen</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-cs-ink-200">
          <% @images.each do |forum_image| %>
            <tr class="hover:bg-cs-ink-50 <%= 'bg-orange-50' if forum_image.orphaned? %>">
              <td class="px-6 py-4">
                <% if forum_image.image.attached? %>
                  <%= image_tag forum_image.image, class: "h-12 w-12 object-cover rounded", alt: "Vorschau" %>
                <% else %>
                  <div class="h-12 w-12 bg-cs-ink-200 rounded flex items-center justify-center">
                    <i class="fa-solid fa-image text-cs-ink-400"></i>
                  </div>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-cs-ink-900"><%= forum_image.user&.username || "(gelöschter Benutzer)" %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-cs-ink-500">
                  <% if forum_image.image.attached? %>
                    <%= number_to_human_size(forum_image.image.blob.byte_size) %>
                  <% end %>
                </div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-cs-ink-900"><%= l(forum_image.created_at, format: :short) %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <% if forum_image.orphaned? %>
                  <% days_left = 30 - (Time.current - forum_image.orphaned_at).to_i / 1.day %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-orange-100 text-orange-800">
                    <i class="fa-solid fa-triangle-exclamation mr-1"></i>
                    Verwaist – Löschung in <%= days_left %> <%= days_left == 1 ? 'Tag' : 'Tagen' %>
                  </span>
                <% else %>
                  <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-cs-success-100 text-cs-success-900">
                    <i class="fa-solid fa-check mr-1"></i>
                    In Verwendung
                  </span>
                <% end %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right text-sm font-medium">
                <div class="flex items-center justify-end gap-2">
                  <% if forum_image.orphaned? %>
                    <%= button_to restore_admin_image_path(forum_image, filter: params[:filter]), method: :post,
                          class: "btn btn-outline btn-sm",
                          title: "Wiederherstellen" do %>
                      <i class="fa-solid fa-rotate-left"></i>
                    <% end %>
                  <% end %>
                  <%= button_to admin_image_path(forum_image, filter: params[:filter]), method: :delete,
                        class: "btn btn-sm text-red-600 hover:text-red-800 border border-red-300 hover:border-red-500",
                        data: { turbo_confirm: "Bild wirklich sofort löschen? Diese Aktion kann nicht rückgängig gemacht werden." },
                        title: "Sofort löschen" do %>
                    <i class="fa-solid fa-trash"></i>
                  <% end %>
                </div>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if @pagy.pages > 1 %>
      <div class="mt-6">
        <%== @pagy.series_nav %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-white rounded-lg shadow border border-cs-ink-200 p-12 text-center">
      <i class="fa-solid fa-images text-6xl text-cs-ink-300 mb-4"></i>
      <h3 class="text-xl font-semibold text-cs-ink-700 mb-2">
        <% if params[:filter] == "orphan" %>
          Keine verwaisten Bilder
        <% else %>
          Keine Forum-Bilder vorhanden
        <% end %>
      </h3>
    </div>
  <% end %>

<% elsif @tab == "avatar" %>

  <% if @images.any? %>
    <div class="bg-white rounded-lg shadow border border-cs-ink-200 overflow-hidden">
      <table class="min-w-full divide-y divide-cs-ink-200">
        <thead class="bg-cs-ink-50">
          <tr>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-cs-ink-500 uppercase tracking-wider">Avatar</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-cs-ink-500 uppercase tracking-wider">Benutzer</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-cs-ink-500 uppercase tracking-wider">Größe</th>
            <th scope="col" class="px-6 py-3 text-left text-xs font-medium text-cs-ink-500 uppercase tracking-wider">Hochgeladen</th>
            <th scope="col" class="px-6 py-3 text-right text-xs font-medium text-cs-ink-500 uppercase tracking-wider">Aktionen</th>
          </tr>
        </thead>
        <tbody class="bg-white divide-y divide-cs-ink-200">
          <% @images.each do |attachment| %>
            <tr class="hover:bg-cs-ink-50">
              <td class="px-6 py-4">
                <%= image_tag rails_blob_path(attachment.blob), class: "h-12 w-12 object-cover rounded-full", alt: "Avatar" %>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-cs-ink-900"><%= attachment.record&.username || "(gelöschter Benutzer)" %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-cs-ink-500"><%= number_to_human_size(attachment.blob.byte_size) %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap">
                <div class="text-sm text-cs-ink-900"><%= l(attachment.created_at, format: :short) %></div>
              </td>
              <td class="px-6 py-4 whitespace-nowrap text-right">
                <% if attachment.record %>
                  <%= button_to destroy_avatar_admin_images_path(attachment.record), method: :delete,
                        class: "btn btn-sm text-red-600 hover:text-red-800 border border-red-300 hover:border-red-500",
                        data: { turbo_confirm: "Avatar von #{attachment.record.username} löschen?" },
                        title: "Avatar löschen" do %>
                    <i class="fa-solid fa-trash"></i>
                  <% end %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <!-- Pagination -->
    <% if @pagy.pages > 1 %>
      <div class="mt-6">
        <%== @pagy.series_nav %>
      </div>
    <% end %>
  <% else %>
    <div class="bg-white rounded-lg shadow border border-cs-ink-200 p-12 text-center">
      <i class="fa-solid fa-user-circle text-6xl text-cs-ink-300 mb-4"></i>
      <h3 class="text-xl font-semibold text-cs-ink-700 mb-2">Keine Avatare vorhanden</h3>
    </div>
  <% end %>

<% end %>
