<!-- Page header -->
<div class="mb-8">
  <h1 class="font-display font-semibold text-[52px] leading-none tracking-tight text-cs-red-900">Rezept-Kategorien</h1>
  <div class="w-10 h-0.5 bg-cs-gold-400 mt-3 mb-2.5"></div>
  <p class="text-sm text-cs-ink-500"><%= @tags.length %> Kategorien — Größe entspricht der Rezeptanzahl</p>
</div>

<!-- Tag cloud canvas -->
<div class="rounded-2xl overflow-hidden relative"
     style="background: radial-gradient(ellipse at 50% 40%, #220707 0%, #0F0202 70%)">
  <!-- subtle gold shimmer top-right -->
  <div class="absolute top-0 right-0 w-[500px] h-[500px] pointer-events-none"
       style="background: radial-gradient(circle at 80% 10%, rgba(182,165,85,.06), transparent 60%)"></div>

  <div class="relative z-10 px-10 py-14">
    <% if @tags.empty? %>
      <p class="text-center text-white/50 text-sm">Keine Kategorien gefunden</p>
    <% else %>
      <div class="tag-cloud flex flex-wrap gap-x-5 gap-y-5 justify-center items-center">
        <% @tags.each do |tag| %>
          <%= link_to tag.name,
                      tag_path(tag: tag.name),
                      class: tag_cloud_class(tag.taggings_count),
                      title: "#{tag.taggings_count} #{tag.taggings_count == 1 ? 'Rezept' : 'Rezepte'}" %>
        <% end %>
      </div>
    <% end %>
  </div>
</div>

<!-- Legend -->
<p class="mt-4 text-center text-xs text-cs-ink-400">
  Klick auf eine Kategorie zeigt alle Rezepte mit diesem Tag
</p>
