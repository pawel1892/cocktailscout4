<% content_for :head do %>
  <script>window.userRatingData = <%= raw @user_ratings_json %>;</script>
<% end %>

<!-- Back link -->
<div class="mb-6">
  <%= link_to users_path, class: "link inline-flex items-center gap-1.5 text-sm font-medium" do %>
    <i class="fas fa-arrow-left text-xs"></i>
    Zurück zur Benutzerliste
  <% end %>
</div>

<!-- Page header -->
<div class="mb-8">
  <h1 class="font-display font-semibold text-[52px] leading-none tracking-tight text-cs-red-900">Bewertungen</h1>
  <div class="w-10 h-0.5 bg-cs-gold-400 mt-3 mb-2.5"></div>
  <p class="text-sm text-cs-ink-500">von <%= @user.username %></p>
</div>

<user-rating-distribution></user-rating-distribution>
