<% content_for :title, "Meine Bar - CocktailScout" %>

<% if authenticated? %>

  <!-- ─── Authenticated view ─── -->
  <div class="mb-8 flex items-end justify-between gap-4">
    <div>
      <h1 class="font-display font-semibold text-[52px] leading-none tracking-tight text-cs-red-900">Meine Bar</h1>
      <div class="w-10 h-0.5 bg-cs-gold-400 mt-3 mb-2.5"></div>
      <p class="text-sm text-cs-ink-500">Verwalte deine Zutatenlisten und finde passende Cocktails</p>
    </div>
  </div>

  <ingredient-collections />

<% else %>

  <!-- ─── Unauthenticated landing ─── -->
  <div class="mb-10">
    <h1 class="font-display font-semibold text-[52px] leading-none tracking-tight text-cs-red-900">Meine Bar</h1>
    <div class="w-10 h-0.5 bg-cs-gold-400 mt-3 mb-2.5"></div>
    <p class="text-[17px] text-cs-ink-600 leading-relaxed max-w-xl">Verwalte deine Zutaten und entdecke sofort, welche Cocktails du mixen kannst.</p>
  </div>

  <!-- Feature cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-10">
    <div class="card">
      <div class="card-body">
        <div class="w-11 h-11 rounded-xl bg-cs-red-50 flex items-center justify-center mb-4">
          <i class="fas fa-layer-group text-cs-red-700 text-lg"></i>
        </div>
        <h3 class="font-display font-semibold text-[20px] text-cs-red-900 mb-2 leading-tight">Mehrere Listen</h3>
        <p class="text-cs-ink-600 leading-relaxed">Erstelle verschiedene Zutatenlisten — für deine Hausbar, besondere Anlässe oder deine Einkaufsliste.</p>
      </div>
    </div>

    <div class="card">
      <div class="card-body">
        <div class="w-11 h-11 rounded-xl bg-cs-gold-50 flex items-center justify-center mb-4">
          <i class="fas fa-cocktail text-cs-gold-600 text-lg"></i>
        </div>
        <h3 class="font-display font-semibold text-[20px] text-cs-red-900 mb-2 leading-tight">Rezepte finden</h3>
        <p class="text-cs-ink-600 leading-relaxed">Sieh sofort, welche Cocktails du mit deinen vorhandenen Zutaten mixen kannst — ohne Rätselraten.</p>
      </div>
    </div>

    <div class="card">
      <div class="card-body">
        <div class="w-11 h-11 rounded-xl bg-cs-ink-100 flex items-center justify-center mb-4">
          <i class="fas fa-sticky-note text-cs-ink-500 text-lg"></i>
        </div>
        <h3 class="font-display font-semibold text-[20px] text-cs-red-900 mb-2 leading-tight">Notizen</h3>
        <p class="text-cs-ink-600 leading-relaxed">Füge Notizen zu deinen Listen hinzu — perfekt für Einkaufslisten und geplante Anschaffungen.</p>
      </div>
    </div>
  </div>

  <!-- CTA -->
  <div class="card card-dark">
    <div class="card-body md:flex md:items-center md:justify-between gap-10">
      <div>
        <p class="font-sans font-bold uppercase text-[11px] tracking-widest text-cs-gold-600 mb-2">Kostenlos &amp; ohne Abo</p>
        <h3 class="font-display font-semibold text-[28px] leading-tight text-cs-gold-200 mb-2">Deine Bar, deine Regeln.</h3>
        <p class="text-sm text-cs-gold-100/70 leading-relaxed">Erstelle jetzt ein Konto und starte mit deiner ersten Zutatenliste.</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-3 shrink-0 mt-6 md:mt-0">
        <%= link_to "Jetzt registrieren", new_registration_path, class: "btn btn-gold" %>
        <%= link_to "Anmelden", new_session_path, class: "btn btn-outline-gold" %>
      </div>
    </div>
  </div>

<% end %>
