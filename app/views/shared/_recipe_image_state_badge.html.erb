<% if recipe_image.soft_deleted? %>
  <span class="inline-flex items-center gap-1.5 px-3 py-1 text-sm font-medium bg-cs-ink-100 text-cs-ink-600 rounded-full">
    <i class="fa-solid fa-trash"></i>
    Gelöscht
  </span>
<% else %>
<% case recipe_image.state %>
<% when "pending" %>
  <span class="inline-flex items-center gap-1.5 px-3 py-1 text-sm font-medium bg-cs-warning-100 text-cs-warning-900 rounded-full">
    <i class="fa-solid fa-clock"></i>
    Wartend
  </span>
<% when "approved" %>
  <span class="inline-flex items-center gap-1.5 px-3 py-1 text-sm font-medium bg-cs-success-100 text-cs-success-900 rounded-full">
    <i class="fa-solid fa-check-circle"></i>
    Genehmigt
  </span>
<% when "rejected" %>
  <span class="inline-flex items-center gap-1.5 px-3 py-1 text-sm font-medium bg-cs-error-100 text-cs-error-900 rounded-full">
    <i class="fa-solid fa-times-circle"></i>
    Abgelehnt
  </span>
<% end %>
<% end %>
