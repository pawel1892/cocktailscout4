<% case suggestion.status %>
<% when "pending" %>
  <span class="tag-warning"><i class="fas fa-clock mr-1"></i>Wartend auf Prüfung</span>
<% when "approved" %>
  <span class="tag-success"><i class="fas fa-check-circle mr-1"></i>Genehmigt</span>
<% when "rejected" %>
  <span class="tag-error"><i class="fas fa-times-circle mr-1"></i>Abgelehnt</span>
<% end %>
