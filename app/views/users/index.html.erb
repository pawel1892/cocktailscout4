<% content_for :head do %>
  <%= pagy_seo_tags(@pagy) %>
<% end %>

<!-- Page header -->
<div class="mb-6">
  <h1 class="font-display font-semibold text-[52px] leading-none tracking-tight text-cs-red-900">Benutzer</h1>
  <div class="w-10 h-0.5 bg-cs-gold-400 mt-3 mb-2.5"></div>
  <p class="text-sm text-cs-ink-500"><%= @pagy.count %> <%= User.model_name.human(count: @pagy.count) %> gefunden</p>
</div>

<!-- Filter row -->
<div class="mb-5 flex flex-wrap items-end gap-4">
  <%= form_with url: users_path, method: :get, class: "contents", data: { turbo_frame: "_top" } do |f| %>
    <%= f.hidden_field :sort, value: params[:sort] if params[:sort] %>
    <%= f.hidden_field :direction, value: params[:direction] if params[:direction] %>

    <div class="flex flex-col gap-1 min-w-[220px] flex-1">
      <%= f.label :q, "Benutzer suchen", class: "label-field" %>
      <div class="relative">
        <%= f.text_field :q, value: params[:q], placeholder: "Benutzername…", class: "input-field pl-8" %>
        <i class="fas fa-search absolute left-2.5 top-1/2 -translate-y-1/2 text-cs-ink-400 text-xs pointer-events-none"></i>
      </div>
    </div>

    <label class="check-label self-end pb-[9px]">
      <%= f.check_box :moderators_only, { checked: params[:moderators_only] == "1", class: "check-field" }, "1", "0" %>
      Nur Admins / Moderatoren
    </label>

    <div class="flex gap-2 self-end">
      <%= f.submit "Suchen", class: "btn btn-primary" %>
      <% if params[:q].present? || params[:moderators_only] == "1" %>
        <%= link_to "Zurücksetzen", users_path(params.permit(:sort, :direction)), class: "btn btn-outline" %>
      <% end %>
    </div>
  <% end %>
</div>

<!-- Sort bar -->
<div class="mb-5 flex items-center gap-3">
  <span class="font-sans font-bold uppercase text-[11px] tracking-widest text-cs-ink-400 shrink-0">Sortieren</span>
  <div class="hidden sm:block overflow-x-auto">
    <div class="btn-group">
      <%= sortable "user_stats.points", "Punkte", default_dir: "desc" %>
      <%= sortable "username", "Benutzername" %>
      <%= sortable "last_seen_at", "Zuletzt gesehen", default_dir: "desc" %>
      <%= sortable "created_at", "Registriert seit", default_dir: "desc" %>
    </div>
  </div>
  <% sort_options = [["Punkte", "user_stats.points", "desc"], ["Benutzername", "username", "asc"], ["Zuletzt gesehen", "last_seen_at", "desc"], ["Registriert seit", "created_at", "desc"]] %>
  <select class="input-field sm:hidden" onchange="window.location.href = this.value">
    <% sort_options.each do |label, col, dir| %>
      <option value="<%= request.path + "?" + request.query_parameters.merge(sort: col, direction: dir).to_query %>"
              <%= "selected" if sort_column == col && sort_direction == dir %>>
        <%= label %>
      </option>
    <% end %>
  </select>
</div>

<!-- Top pagination -->
<% if @pagy.pages > 1 %>
  <div class="flex justify-center mb-6">
    <%== @pagy.series_nav %>
  </div>
<% end %>

<% if @users.any? %>

  <!-- Desktop: table -->
  <div class="hidden md:block table-container">
    <table class="table-standard w-full">
      <thead>
        <tr>
          <th class="table-th">Benutzer</th>
          <th class="table-th">Punkte</th>
          <th class="table-th">Zuletzt gesehen</th>
          <th class="table-th">Dabei seit</th>
        </tr>
      </thead>
      <tbody class="table-body">
        <% @users.each do |user| %>
          <tr class="table-tr-hover">
            <td class="table-td">
              <%= user_badge(user) %>
              <div class="mt-1.5">
                <%= render 'users/role_badges', user: user, inline: true %>
              </div>
            </td>
            <td class="table-td">
              <div class="font-mono font-medium text-[14px] text-cs-ink-900"><%= number_with_delimiter(user.points) %></div>
              <div class="text-xs text-cs-ink-400 font-mono">Rang <span><%= user.rank %></span></div>
            </td>
            <td class="table-td">
              <% if user.last_seen_at %>
                <div class="text-sm text-cs-ink-800"><%= user.last_seen_at.strftime("%-d. %b %Y") %></div>
                <div class="text-xs text-cs-ink-400"><%= time_ago_in_words(user.last_seen_at) %> her</div>
              <% else %>
                <span class="text-sm text-cs-ink-300">Noch nie</span>
              <% end %>
            </td>
            <td class="table-td">
              <div class="text-sm text-cs-ink-800"><%= user.created_at.strftime("%-d. %b %Y") %></div>
              <div class="text-xs text-cs-ink-400"><%= time_ago_in_words(user.created_at) %> her</div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <!-- Mobile: divider list -->
  <div class="md:hidden divide-y divide-cs-ink-200">
    <% @users.each do |user| %>
      <div class="flex items-center gap-4 py-4">
        <div class="flex-1 min-w-0">
          <%= user_badge(user) %>
          <div class="mt-1.5">
            <%= render 'users/role_badges', user: user, inline: true %>
          </div>
        </div>
        <div class="text-right shrink-0">
          <div class="font-mono font-medium text-sm text-cs-ink-900"><%= number_with_delimiter(user.points) %></div>
          <div class="text-xs text-cs-ink-400 font-mono">Rang <%= user.rank %></div>
        </div>
      </div>
    <% end %>
  </div>

<% else %>
  <div class="card card-ghost p-12 text-center mt-4">
    <div class="text-cs-ink-300 mb-4"><i class="fas fa-users text-5xl"></i></div>
    <h3 class="font-display font-bold text-xl text-cs-ink-800 mb-2">Keine Benutzer gefunden</h3>
    <p class="text-cs-ink-500 mb-8 max-w-md mx-auto">Leider konnten wir keine Benutzer finden, die deiner Suche entsprechen.</p>
    <%= link_to "Zurücksetzen", users_path, class: "btn btn-primary" %>
  </div>
<% end %>

<!-- Bottom pagination -->
<% if @pagy.pages > 1 %>
  <div class="flex justify-center py-8 border-t border-cs-ink-200">
    <%== @pagy.series_nav %>
  </div>
<% end %>
