<div class="mb-6">
  <h1 class="text-2xl font-bold">Artikel bearbeiten: <%= @wiki_article.title %></h1>
</div>

<div class="card">
  <div class="card-body p-4 sm:p-6">
    <%= form_with model: @wiki_article, url: wiki_article_path(@wiki_article), method: :patch do |form| %>
      <%= render "form", form: form, wiki_article: @wiki_article %>
    <% end %>
  </div>
</div>
