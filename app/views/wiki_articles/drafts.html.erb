<div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
  <div>
    <div class="text-sm text-gray-500 mb-1">
      <%= link_to "← Wiki", wiki_dashboard_path, class: "hover:underline" %>
    </div>
    <h1 class="text-3xl font-bold">Entwürfe</h1>
  </div>
  <%= link_to new_wiki_article_path, class: "btn btn-primary w-full sm:w-auto" do %>
    <i class="fas fa-plus mr-2"></i> Neuer Artikel
  <% end %>
</div>

<% if @draft_articles.empty? %>
  <div class="card">
    <div class="card-body p-8 text-center text-gray-500">
      <i class="fas fa-file-alt text-4xl mb-3 block text-gray-300"></i>
      <p>Keine Entwürfe vorhanden.</p>
    </div>
  </div>
<% else %>
  <div class="card">
    <div class="card-body p-0">
      <ul class="divide-y divide-gray-100">
        <% @draft_articles.each do |article| %>
          <li class="hover:bg-gray-50 transition-colors">
            <%= link_to wiki_article_path(article), class: "flex items-center justify-between gap-4 px-4 py-3 group" do %>
              <div class="min-w-0 flex-1">
                <span class="font-medium text-gray-700 group-hover:underline"><%= article.title %></span>
                <% article.ingredients.each do |ingredient| %>
                  <span class="tag tag-neutral ml-1"><i class="fas fa-flask mr-1"></i><%= ingredient.name %></span>
                <% end %>
              </div>
              <div class="flex items-center gap-2 flex-shrink-0">
                <span class="badge badge-warning badge-sm">Entwurf</span>
                <span class="text-xs text-gray-400"><%= l(article.updated_at, format: :short) %></span>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
<% end %>
