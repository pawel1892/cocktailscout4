<div class="space-y-6">
  <div class="form-group">
    <%= form.label :title, "Titel", class: "label-field" %>
    <% if wiki_article.errors[:title].any? %>
      <div class="text-cs-error text-sm mb-1"><%= wiki_article.errors.full_messages_for(:title).join(", ") %></div>
    <% end %>
    <%= form.text_field :title, class: "input-field", placeholder: "Artikel-Titel" %>
  </div>

  <div class="form-group">
    <%= form.label :ingredient_id, "Zutat (optional)", class: "label-field" %>
    <p class="text-sm text-gray-500 mb-2">Verknüpft diesen Artikel mit einer Zutat. Auf dem Artikel werden alle Rezepte mit dieser Zutat angezeigt.</p>
    <%= form.collection_select :ingredient_id, Ingredient.order(:name), :id, :name,
        { include_blank: "— Kein Bezug zu einer Zutat —" },
        { class: "input-field" } %>
  </div>

  <div class="form-group">
    <%= form.label :body, "Inhalt", class: "label-field" %>
    <% if wiki_article.errors[:body].any? %>
      <div class="text-cs-error text-sm mb-2"><%= wiki_article.errors.full_messages_for(:body).join(", ") %></div>
    <% end %>
    <markdown-editor
      model-value="<%= wiki_article.body %>"
      textarea-id="wiki_article_body"
      textarea-name="<%= form.object_name %>[body]"
      :smileys="<%= BbcodeHelper::SMILEYS.to_json %>"
      :show-internal-links="true"
    ></markdown-editor>
  </div>

  <div class="form-group">
    <label class="flex items-center gap-3 cursor-pointer">
      <%= form.check_box :published, class: "w-4 h-4 accent-cs-dark-red" %>
      <span class="label-field mb-0">Veröffentlicht</span>
    </label>
    <p class="text-sm text-gray-500 mt-1">Unveröffentlichte Artikel sind nur für Wiki-Editoren sichtbar.</p>
  </div>

  <div class="flex justify-end gap-2">
    <%= link_to "Abbrechen", :back, class: "btn btn-outline" %>
    <%= form.submit "Speichern", class: "btn btn-primary" %>
  </div>
</div>
