<%
  footer_link_class = "text-cs-red-200/70 no-underline border-b border-transparent transition-colors hover:border-cs-red-200/50 hover:text-cs-red-100 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cs-red-200 rounded-[2px]"
%>

<footer class="mt-12 border-t border-cs-red-800/70 bg-cs-red-925 text-cs-red-200/70">
  <div class="mx-auto max-w-[1180px] px-4 py-7 sm:px-6 lg:px-8">
    <div class="grid gap-7 sm:grid-cols-2 md:grid-cols-[1.15fr_.8fr_.8fr_.8fr_auto] md:items-start">
      <div>
        <%= link_to root_path, class: "inline-flex text-cs-red-100/65 transition-colors hover:text-cs-red-100 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-cs-red-200 rounded-[2px]", aria: { label: "CocktailScout Startseite" } do %>
          <%= render "layouts/logo_wordmark", css_class: "h-5 w-auto fill-current" %>
        <% end %>
      </div>

      <nav aria-label="Entdecken">
        <h2 class="font-sans text-[10px] font-bold uppercase tracking-widest text-cs-red-100/80">Entdecken</h2>
        <ul class="mt-3 flex flex-col gap-1.5 text-[13px]">
          <li><%= link_to "Rezepte", recipes_path, class: footer_link_class %></li>
          <li><%= link_to "Kategorien", recipe_categories_path, class: footer_link_class %></li>
          <li><%= link_to "Toplisten", top_lists_path, class: footer_link_class %></li>
          <li><%= link_to "Galerie", recipe_images_path, class: footer_link_class %></li>
        </ul>
      </nav>

      <nav aria-label="Community">
        <h2 class="font-sans text-[10px] font-bold uppercase tracking-widest text-cs-red-100/80">Community</h2>
        <ul class="mt-3 flex flex-col gap-1.5 text-[13px]">
          <li><%= link_to "Community", community_path, class: footer_link_class %></li>
          <li><%= link_to "Forum", forum_topics_path, class: footer_link_class %></li>
          <li><%= link_to "Meine Bar", my_bar_path, class: footer_link_class %></li>
        </ul>
      </nav>

      <div>
        <h2 class="font-sans text-[10px] font-bold uppercase tracking-widest text-cs-red-100/80">Kontakt</h2>
        <div class="mt-3 flex flex-col gap-1.5 text-[13px]">
          <%= link_to "Impressum", impressum_path, class: footer_link_class %>
          <%= link_to "Datenschutz", datenschutz_path, class: footer_link_class %>
          <%= link_to "https://github.com/pawel1892/cocktailscout4", class: "#{footer_link_class} inline-flex items-center gap-2", target: "_blank", rel: "noopener" do %>
            <i class="fa-brands fa-github text-[13px]"></i>
            <span>GitHub</span>
          <% end %>
        </div>
      </div>

      <div class="hidden justify-self-end md:block">
        <img src="/logo_icon.svg" class="h-24 w-auto opacity-25 grayscale sepia lg:h-28" alt="">
      </div>
    </div>
  </div>
</footer>
