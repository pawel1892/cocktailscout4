<!DOCTYPE html>
<html lang="de">
  <head>
    <%= display_meta_tags(default_meta_tags) %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="CocktailScout">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=Playfair+Display:ital,wght@0,400;0,600;0,700;0,800;1,400&family=Libre+Caslon+Text:ital,wght@0,400;0,700;1,400&family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png?v=4" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png?v=4">

    <%= vite_client_tag %>
    <%= vite_javascript_tag 'application' %>
    <%= vite_javascript_tag 'mobile-menu' %>
    <%= vite_stylesheet_tag 'application' %>

    <% authenticated? %>
    <meta name="current-user" content="<%= (Current.user ? Current.user.as_json(only: [:id, :email_address, :username]).merge(is_moderator: Current.user.moderator?) : nil).to_json %>">
  </head>

  <body>
    <div id="app" class="min-h-screen flex flex-col">
      <%= render "layouts/header" %>

      <%= render "layouts/flash_messages" %>

      <% if content_for?(:full_bleed_page) %>
        <div class="w-full grow">
          <%= yield %>
        </div>
      <% else %>
        <div class="container mx-auto px-4 py-6 grow">
          <%= yield %>
        </div>
      <% end %>

      <%= render "layouts/footer" %>

      <user-profile-modal></user-profile-modal>
      <content-report-modal></content-report-modal>
    </div>
    <% if Current.user %>
      <script type="module">
        const csrf = () => document.querySelector('meta[name="csrf-token"]')?.content
        const beat = () => fetch('/heartbeat', {
          method: 'POST',
          headers: { 'X-CSRF-Token': csrf(), 'Content-Type': 'application/json' }
        }).catch(() => {})
        beat()
        setInterval(beat, 2 * 60 * 1000)
      </script>
    <% end %>
  </body>
</html>
