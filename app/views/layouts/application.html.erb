<!DOCTYPE html>
<html lang="de">
  <head>
    <%= display_meta_tags(default_meta_tags) %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="CocktailScout">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png?v=4" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png?v=4">

    <%= vite_client_tag %>
    <%= vite_javascript_tag 'application' %>
    <%= vite_stylesheet_tag 'application' %>

    <% authenticated? %>
    <meta name="current-user" content="<%= (Current.user ? Current.user.as_json(only: [:id, :email_address, :username]).merge(is_moderator: Current.user.moderator?, can_moderate_recipe: Current.user.can_moderate_recipe?, avatar_url_small: Current.user.avatar_path(:small)) : nil).to_json %>">
  </head>

  <body>
    <div id="app" class="min-h-screen flex flex-col">
      <%= render "layouts/header" %>

      <%= render "layouts/flash_messages" %>

      <% if content_for?(:full_bleed_page) %>
        <div class="w-full grow">
          <%= yield %>
        </div>
      <% else %>
        <div class="max-w-[1180px] mx-auto w-full px-4 sm:px-6 lg:px-8 py-6 grow">
          <%= render_breadcrumbs %>
          <%= yield %>
        </div>
      <% end %>

      <%= render "layouts/footer" %>

      <user-profile-modal></user-profile-modal>
      <content-report-modal></content-report-modal>
    </div>
    <% if Current.user %>
      <script type="module">
        const csrf = () => document.querySelector('meta[name="csrf-token"]')?.content
        const beat = () => fetch('/heartbeat', {
          method: 'POST',
          headers: { 'X-CSRF-Token': csrf(), 'Content-Type': 'application/json' }
        }).catch(() => {})
        beat()
        setInterval(beat, 2 * 60 * 1000)
      </script>
    <% end %>
  </body>
</html>
