<header id="site-header" class="site-header sticky top-0 z-50 bg-cs-ink-50/95 text-cs-ink-900 backdrop-blur-md border-b border-cs-ink-200 shadow-[0_10px_30px_-28px_rgba(24,21,19,.65)]">
  <div class="max-w-[1180px] mx-auto px-4 sm:px-6 lg:px-8 w-full">
    <div class="site-header-inner grid grid-cols-[auto_1fr_auto] lg:grid-cols-[minmax(180px,1fr)_auto_minmax(180px,1fr)] items-center gap-3 py-5">
      <div class="flex items-center">
        <%= link_to root_path, class: "inline-flex items-center no-underline", aria: { label: "CocktailScout Startseite" } do %>
          <img src="/logo_red.svg" class="site-logo h-12 sm:h-14 lg:h-16 w-auto" alt="CocktailScout">
        <% end %>
      </div>

      <nav class="hidden lg:flex items-stretch justify-center overflow-hidden rounded-md border border-cs-red-200 bg-cs-red-50 shadow-[inset_0_1px_0_rgba(255,255,255,.65),0_8px_18px_-16px_rgba(24,21,19,.45)]" aria-label="Hauptnavigation">
        <% main_navigation_items.each do |item| %>
          <% active = main_nav_item_active?(item) %>
          <%= link_to item[:label], item[:path], class: "relative flex min-w-28 items-center justify-center border-r border-cs-red-100 px-4 py-2.5 text-[11px] font-bold uppercase tracking-[0.16em] no-underline transition last:border-r-0 #{active ? 'bg-cs-gold-300 text-cs-red-950 shadow-[inset_0_-3px_0_#938016]' : 'text-cs-red-900 hover:bg-white hover:text-cs-red-700'}", aria: (active ? { current: "page" } : {}) %>
        <% end %>
      </nav>

      <div class="hidden lg:flex items-center justify-end gap-3 min-w-0">
        <user-session></user-session>
      </div>

      <button id="mobile-menu-btn" type="button" onclick="toggleMobileMenu(event)" class="col-start-3 justify-self-end lg:hidden inline-flex size-10 items-center justify-center rounded-md border border-cs-red-200 bg-cs-red-50 text-cs-red-900 shadow-xs transition hover:bg-white hover:text-cs-red-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cs-gold-500" aria-label="Navigation öffnen" aria-controls="mobile-menu" aria-expanded="false">
        <i class="fa-solid fa-bars text-lg leading-none"></i>
      </button>
    </div>
  </div>

  <%= render "layouts/secondary_nav" %>

  <div id="mobile-menu-backdrop" class="fixed inset-0 z-[80] hidden bg-black/40 opacity-0 transition-opacity duration-200 lg:hidden" onclick="closeMobileMenu()"></div>

  <aside id="mobile-menu" class="fixed right-0 top-0 z-[90] flex h-dvh w-[min(22rem,calc(100vw-2rem))] translate-x-full flex-col border-l border-cs-red-950 bg-cs-ink-50 shadow-2xl transition-transform duration-200 lg:hidden" aria-label="Mobile Navigation" aria-hidden="true">
    <div class="flex items-center justify-between border-b border-cs-red-950 bg-cs-red-900 px-5 py-4">
      <%= link_to root_path, class: "inline-flex items-center no-underline", aria: { label: "CocktailScout Startseite" } do %>
        <img src="/logo.svg" class="h-8 w-auto" alt="CocktailScout">
      <% end %>

      <button type="button" onclick="closeMobileMenu()" class="inline-flex size-9 items-center justify-center rounded-md text-cs-gold-200 transition hover:bg-white/10 hover:text-cs-gold-300 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-cs-gold-500" aria-label="Navigation schließen">
        <i class="fa-solid fa-xmark text-lg leading-none"></i>
      </button>
    </div>

    <div id="mobile-menu-content" class="flex-1 overflow-y-auto px-5 py-5 transition-opacity duration-200">
      <nav class="flex flex-col gap-2" aria-label="Hauptnavigation mobil">
        <% main_navigation_items.each do |item| %>
          <% active = main_nav_item_active?(item) %>
          <% if item[:dropdown].present? %>
            <details class="group overflow-hidden rounded-md border border-cs-ink-200 bg-white shadow-xs" <%= "open" if active %>>
              <summary class="flex cursor-pointer list-none items-center justify-between gap-3 border-l-4 px-3 py-3 text-[12px] font-bold uppercase tracking-[0.13em] transition [&::-webkit-details-marker]:hidden <%= active ? 'border-cs-gold-500 bg-cs-red-900 text-cs-gold-100' : 'border-cs-ink-200 text-cs-ink-800 hover:border-cs-gold-500 hover:text-cs-red-900' %>">
                <span><%= item[:label] %></span>
                <i class="fa-solid fa-chevron-down text-[11px] opacity-70 transition-transform group-open:rotate-180"></i>
              </summary>
              <div class="border-t border-cs-ink-100 px-2 py-2">
                <%= link_to item[:label], item[:path], class: "block rounded px-3 py-2 text-sm font-semibold no-underline transition #{active ? 'text-cs-red-900 bg-cs-red-50' : 'text-cs-ink-700 hover:bg-cs-ink-100 hover:text-cs-red-900'}" %>
                <% item[:dropdown].each do |subitem| %>
                  <% sub_active = subnav_item_active?(subitem) %>
                  <%= link_to subitem[:label], subitem[:path], class: "block rounded px-3 py-2 text-sm no-underline transition #{sub_active ? 'font-semibold text-cs-red-900 bg-cs-red-50' : 'text-cs-ink-700 hover:bg-cs-ink-100 hover:text-cs-red-900'}", aria: (sub_active ? { current: "page" } : {}) %>
                <% end %>
              </div>
            </details>
          <% else %>
            <%= link_to item[:label], item[:path], class: "rounded-md border border-cs-ink-200 border-l-4 px-3 py-3 text-[12px] font-bold uppercase tracking-[0.13em] no-underline shadow-xs transition #{active ? 'border-l-cs-gold-500 bg-cs-red-900 text-cs-gold-100' : 'border-l-cs-ink-200 bg-white text-cs-ink-800 hover:border-l-cs-gold-500 hover:text-cs-red-900'}", aria: (active ? { current: "page" } : {}) %>
          <% end %>
        <% end %>
      </nav>

      <div class="mt-4 border-t border-cs-ink-200 pt-4">
        <%= form_tag recipes_path, method: :get do %>
          <div class="relative">
            <input type="search" name="q" value="<%= params[:q] %>" placeholder="Rezepte suchen…"
                   class="w-full rounded-md border border-cs-ink-200 bg-white py-2 pl-3 pr-9 text-sm text-cs-ink-800 placeholder-cs-ink-400 transition focus:border-cs-gold-500 focus:outline-none focus:ring-1 focus:ring-cs-gold-400">
            <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-cs-ink-400 transition-colors hover:text-cs-red-700" aria-label="Rezepte suchen">
              <i class="fa-solid fa-magnifying-glass text-sm"></i>
            </button>
          </div>
        <% end %>
      </div>
    </div>

    <div class="border-t border-cs-ink-200 px-5 py-3">
      <user-session drawer></user-session>
    </div>
  </aside>
</header>
