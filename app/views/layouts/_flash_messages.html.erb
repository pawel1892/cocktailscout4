<% if flash.any? %>
  <div class="container mx-auto px-4 pt-4">
    <% flash.each do |type, message| %>
      <%
        case type.to_sym
        when :notice
          classes = "bg-cs-success-50 border-l-4 border-cs-success-500 text-cs-success-900"
          icon = "fa-check-circle"
        when :alert
          classes = "bg-cs-error-50 border-l-4 border-cs-error-500 text-cs-error-900"
          icon = "fa-exclamation-circle"
        when :warning
          classes = "bg-cs-warning-50 border-l-4 border-cs-warning-500 text-cs-warning-900"
          icon = "fa-exclamation-triangle"
        else
          classes = "bg-cs-info-50 border-l-4 border-cs-info-500 text-cs-info-900"
          icon = "fa-info-circle"
        end
      %>
      <div class="<%= classes %> p-4 rounded-r-md mb-4 flex items-start gap-3 shadow-xs" role="alert">
        <i class="fas <%= icon %> mt-0.5 flex-shrink-0"></i>
        <p class="flex-1"><%= message %></p>
        <button onclick="this.parentElement.remove()" class="flex-shrink-0 can-hover:opacity-50 hover:opacity-100 transition">
          <i class="fas fa-times"></i>
        </button>
      </div>
    <% end %>
  </div>
<% end %>
