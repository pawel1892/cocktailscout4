<% if show_subnav? %>
  <div id="secondary-nav" class="hidden lg:block bg-cs-red-50 border-t border-cs-red-100">
    <div class="max-w-[1180px] mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <nav class="flex items-center gap-5 overflow-x-auto py-2.5" aria-label="<%= current_nav_item[:label] %> Navigation">
        <% subnav_items.each do |item| %>
          <% active = subnav_item_active?(item) %>
          <%= link_to item[:label], item[:path], class: "relative shrink-0 py-1 text-[11px] font-bold uppercase tracking-[0.14em] no-underline transition after:absolute after:left-0 after:right-0 after:-bottom-2.5 after:h-0.5 after:transition #{active ? 'text-cs-red-900 after:bg-cs-gold-500' : 'text-cs-ink-600 after:bg-transparent hover:text-cs-red-900 hover:after:bg-cs-gold-300'}", aria: (active ? { current: "page" } : {}) %>
        <% end %>
      </nav>
    </div>
  </div>
<% end %>
